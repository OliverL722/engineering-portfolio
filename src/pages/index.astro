      /* ---------- nav: orange menu button that stretches open on click ---------- */
      const REDUCED = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const navBurger = document.getElementById("navBurger");
      const pillTabs = document.getElementById("pillTabs");
      const ACCENT = "#dd5b3c", GLASS = "rgba(22,19,14,.55)", LINE2 = "rgba(233,214,180,.26)";
      let navOpen = false, navAnim = null;
      function pillSize() { return { h: pillGroup.offsetHeight, w: pillTabs.scrollWidth + 14 }; } // 6px padding + 1px border each side
      function openNav() {
        if (navOpen) return;
        navOpen = true;
        const { w, h } = pillSize();
        if (navAnim) navAnim.cancel();
        pillGroup.classList.remove("is-collapsed");
        navBurger.setAttribute("aria-expanded", "true");
        navBurger.setAttribute("aria-label", "Close menu");
        movePill();
        if (REDUCED) return;
        navAnim = pillGroup.animate([
          { width: h + "px", height: h + "px", backgroundColor: ACCENT, borderColor: ACCENT, easing: "ease-out" },
          { width: h * 0.9 + "px", height: h * 1.06 + "px", backgroundColor: ACCENT, borderColor: ACCENT, offset: 0.16, easing: "cubic-bezier(.55,0,.25,1)" },
          { width: w * 1.1 + "px", height: h * 0.88 + "px", backgroundColor: GLASS, borderColor: LINE2, offset: 0.55, easing: "ease-in-out" },
          { width: w * 0.965 + "px", height: h * 1.05 + "px", offset: 0.72, easing: "ease-in-out" },
          { width: w * 1.012 + "px", height: h + "px", offset: 0.86, easing: "ease-in-out" },
