            [0, [["a", 12], ["m", 44]]], [1, [["m", 30], ["m", 16]]], [2, [["m", 38]]],
            [0, [["a", 16], ["m", 22]]], [1, [["m", 20], ["a", 10], ["m", 24]]], [0, [["m", 8]]],
            [0, [["a", 10], ["m", 50]]], [1, [["m", 34], ["m", 12]]], [2, [["a", 18], ["m", 18]]]
          ];
          const build = () => { let h = ""; rows.forEach(([ind, bars]) => { h += '<div class="cl">'; for (let k = 0; k < ind; k++) h += '<span class="ind"></span>'; bars.forEach(([cls, w]) => (h += '<span class="bar ' + cls + '" style="width:' + w + 'px"></span>')); h += "</div>"; }); return h; };
          host.innerHTML = build() + build();
          let off = 0, cv = 0.13, tv = 0.13; // px/frame; hover slows to a crawl
          const scard = host.closest(".project-category-card");
          if (scard) {
            scard.addEventListener("mouseenter", () => { tv = 0.035; });
            scard.addEventListener("mouseleave", () => { tv = 0.13; });
          }
          (function sloop() {
            cv += (tv - cv) * 0.06; off += cv;
            const half = host.scrollHeight / 2;
            if (half > 0 && off >= half) off -= half;
            host.style.transform = "translateY(-" + off.toFixed(2) + "px)";
            requestAnimationFrame(sloop);
          })();
        }
        // gear train — Current Projects. JS-driven so hover speed changes ease smoothly.
        const gsvg = document.getElementById("projGears");
        if (gsvg && !gsvg._init) {
          gsvg._init = true;
          const ac = "221,91,60";
          const gp = (teeth, rOut, rRoot, hole) => {
            const TAU = Math.PI * 2, steps = teeth * 4; let d = "";
            for (let i = 0; i < steps; i++) { const a = (i + 0.5) / steps * TAU; const r = (i % 4 < 2) ? rOut : rRoot; d += (i ? "L" : "M") + (Math.cos(a) * r).toFixed(1) + " " + (Math.sin(a) * r).toFixed(1) + " "; }
            d += "Z";
            if (hole) d += " M" + hole + " 0 A" + hole + " " + hole + " 0 1 0 -" + hole + " 0 A" + hole + " " + hole + " 0 1 0 " + hole + " 0 Z";
            return d;
          };
          gsvg.innerHTML =
            '<g transform="translate(52,92) rotate(-7.5)"><g id="gearBig">' +
            '<path d="' + gp(12, 42, 30, 7) + '" fill="rgba(' + ac + ',.10)" stroke="#dd5b3c" stroke-width="1.6" fill-rule="evenodd"></path>' +
            '<circle r="14" fill="none" stroke="rgba(' + ac + ',.4)" stroke-width="1"></circle></g></g>' +
            '<g transform="translate(112,92) rotate(11.25)"><g id="gearSm">' +
            '<path d="' + gp(8, 30, 18, 5) + '" fill="rgba(' + ac + ',.10)" stroke="#dd5b3c" stroke-width="1.6" fill-rule="evenodd"></path>' +
            '<circle r="9" fill="none" stroke="rgba(' + ac + ',.4)" stroke-width="1"></circle></g></g>';
          const big = gsvg.querySelector("#gearBig"), sm = gsvg.querySelector("#gearSm");
          let A = 0, w = 0.25, tw = 0.25; // deg/frame; 0.25 = 24s per rev
          const gcard = gsvg.closest(".project-category-card");
          if (gcard) {
            gcard.addEventListener("mouseenter", () => { tw = 0.0625; });
            gcard.addEventListener("mouseleave", () => { tw = 0.25; });
          }
          (function gloop() {
            w += (tw - w) * 0.06; A += w;
            big.setAttribute("transform", "rotate(" + A.toFixed(2) + ")");
            sm.setAttribute("transform", "rotate(" + (-A * 1.5).toFixed(2) + ")"); // 12:8 mesh ratio
