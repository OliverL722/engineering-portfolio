<html lang="en" data-ol-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f5f7" />
    <meta name="description" content="Oliver Lesiakowski — Mechanical Engineering student at UIUC with a CS minor. Experience, coursework, and engineering projects." />
    <title>Oliver Lesiakowski | Engineering Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href="/favicon.ico?v=ol" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=ol" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=ol" />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- before first paint: light by default on every visit (a dark pick lasts for this tab only) + the intro only when landing on Home -->
    <script is:inline>
      (function () {
        var d = document.documentElement, t = 'light';
        try { if (sessionStorage.getItem('ol-theme') === 'dark') t = 'dark'; } catch (e) {}
        d.setAttribute('data-ol-theme', t);
        if (t === 'dark') { var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', '#0a0a0b'); }
        var v = (location.hash || '').slice(1).split('/')[0];
        var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if ((v === '' || v === 'home') && !still) d.classList.add('intro');
      })();
    </script>

    <style is:global>
      /* ================= TOKENS ================= */
      :root,[data-ol-theme=light]{
        color-scheme:light;
        --bg:#f5f5f7;--surf:#fff;--surf2:#f2f2f4;--ph:#ececef;--ph2:#e8e8eb;--ph3:#eeeef1;
        --ink:#1d1d1f;--t2:#424245;--t3:#6e6e73;--t4:#86868b;--t5:#3a3a3c;
        --line:rgba(0,0,0,.07);--line2:rgba(0,0,0,.12);--line3:rgba(0,0,0,.18);
        --acc:#ff6a3d;--accg:#e8501f;--acct:#c4421a;--acct2:#b23c16;--onacc:#1d1d1f;--tint:rgba(255,106,61,.12);--indring:rgba(232,80,31,.35);
        --shadow:0 1px 2px rgba(17,17,26,.04),0 10px 30px rgba(17,17,26,.05);
        --shadowL:0 1px 2px rgba(17,17,26,.04),0 24px 60px rgba(17,17,26,.08);
        --shadowH:0 2px 4px rgba(17,17,26,.04),0 22px 50px rgba(17,17,26,.11);
        --glass:rgba(255,255,255,.8);--glassln:rgba(0,0,0,.08);--navsh:0 12px 36px rgba(17,17,26,.08),0 1px 2px rgba(17,17,26,.04);
        --spot:rgba(255,106,61,.14);--spot2:rgba(255,106,61,.04);--dots:rgba(0,0,0,.14);--hair:rgba(0,0,0,.18);--dotglow2:0 0 0 4px rgba(255,106,61,.15);
        --name1:#1d1d1f;--name1t:rgba(29,29,31,0);--name2:#86868b;--name2t:rgba(134,134,139,0);
        --green:#17703d;--greenln:rgba(26,127,69,.35);--greenbg:rgba(34,165,90,.08);--greendot:#22a55a;
        --chipbg:#f5f5f7;--ghostbg:rgba(255,255,255,.6);--pillbg:#fff;--arrowbg:rgba(255,255,255,.88);--dotoff:rgba(0,0,0,.25);
        --code:rgba(0,0,0,.16);--screen:#f5f5f7;--wheel:#fff;--foot:#fff;--track:rgba(0,0,0,.07);--cad1:#fff;--cadbg:#e9e9ed;--lbbg:rgba(245,245,247,.86);
        --g-me:#e2531b;--g-math:#2563eb;--g-cs:#15803d;--g-eng:#7c3aed;--g-sci:#0e7490;--g-gen:#be185d;--ring:#e8501f;
        --tileon:#fff;--tileglow:0 0 0 1px rgba(232,80,31,.15),0 18px 44px rgba(17,17,26,.1),0 0 40px rgba(255,106,61,.12);
        --dotglow:0 0 0 5px rgba(255,106,61,.18);--fillglow:none;--glow:none;
      }
      [data-ol-theme=dark]{
        color-scheme:dark;
        --bg:#0a0a0b;--surf:#141416;--surf2:rgba(255,255,255,.06);--ph:#1b1b1e;--ph2:#1d1c1f;--ph3:#1a1b1e;
        --ink:#f5f5f7;--t2:#c7c7cc;--t3:#a1a1a6;--t4:#8e8e93;--t5:#d1d1d6;
        --line:rgba(255,255,255,.08);--line2:rgba(255,255,255,.14);--line3:rgba(255,255,255,.24);
        --acc:#ff6a3d;--accg:#ff6a3d;--acct:#ff8a65;--acct2:#ff8a65;--onacc:#0a0a0b;--tint:rgba(255,106,61,.14);--indring:rgba(255,106,61,.4);
        --shadow:none;--shadowL:0 30px 80px rgba(0,0,0,.5);--shadowH:0 26px 60px rgba(0,0,0,.55),0 0 60px rgba(255,106,61,.08);
        --glass:rgba(24,24,27,.72);--glassln:rgba(255,255,255,.1);--navsh:0 12px 40px rgba(0,0,0,.45);
        --spot:rgba(255,106,61,.16);--spot2:rgba(255,106,61,.05);--dots:rgba(255,255,255,.16);--hair:rgba(255,255,255,.28);--dotglow2:0 0 14px 2px rgba(255,106,61,.7);
        --name1:#f5f5f7;--name1t:rgba(245,245,247,0);--name2:#8e8e93;--name2t:rgba(142,142,147,0);
        --green:#5be39a;--greenln:rgba(61,220,132,.4);--greenbg:transparent;--greendot:#3ddc84;
        --chipbg:rgba(255,255,255,.03);--ghostbg:transparent;--pillbg:rgba(255,255,255,.04);--arrowbg:rgba(10,10,11,.6);--dotoff:rgba(255,255,255,.35);
        --code:rgba(255,255,255,.2);--screen:#0e0e10;--wheel:#141416;--foot:#0c0c0d;--track:rgba(255,255,255,.08);--cad1:#e4e4e8;--cadbg:#bdbdc4;--lbbg:rgba(8,8,9,.88);
        --g-me:#ff8a5c;--g-math:#7aa7ff;--g-cs:#4ade80;--g-eng:#b69aff;--g-sci:#3cc7e3;--g-gen:#f472b6;--ring:#ff6a3d;
        --tileon:#19191c;--tileglow:0 0 0 1px rgba(255,106,61,.15),0 18px 50px rgba(0,0,0,.5),0 0 50px rgba(255,106,61,.1);
        --dotglow:0 0 0 5px rgba(255,106,61,.18),0 0 14px rgba(255,106,61,.7);--fillglow:0 0 10px rgba(255,106,61,.6);--glow:0 0 10px rgba(255,106,61,.7);
      }

      /* ================= BASE ================= */
      *,*::before,*::after{box-sizing:border-box}
      html{-webkit-text-size-adjust:100%;scrollbar-gutter:stable}
      body{margin:0;min-height:100vh;background:var(--bg);color:var(--ink);font-family:'Hanken Grotesk',-apple-system,'Helvetica Neue',sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden;transition:background-color .45s ease,color .45s ease}
      [hidden]{display:none !important}
      a{color:var(--acct)}
      button{font:inherit;color:inherit;letter-spacing:inherit}
      img{display:block}
      .mono{font-family:inherit;font-weight:600;font-variant-numeric:tabular-nums}
      :focus-visible{outline:2px solid var(--accg);outline-offset:3px}
      .theme-swap *,.theme-swap *::before,.theme-swap *::after{transition:none !important}

      /* theme switch: circular reveal from the toggle */
      ::view-transition-old(root),::view-transition-new(root){animation:none;mix-blend-mode:normal}
      ::view-transition-new(root){animation:themeReveal .75s cubic-bezier(.65,0,.35,1)}

      /* ================= NAV ================= */
      .top{position:fixed;top:22px;left:0;right:0;z-index:50;display:flex;justify-content:center;padding:0 16px;pointer-events:none}
      .bar{pointer-events:auto;display:flex;align-items:center;padding:5px;border-radius:999px;background:var(--glass);border:1px solid var(--glassln);box-shadow:var(--navsh);-webkit-backdrop-filter:blur(20px) saturate(1.6);backdrop-filter:blur(20px) saturate(1.6)}
      .tabs{position:relative;display:flex;gap:2px;width:min(424px,calc(100vw - 100px))}
      .ind{position:absolute;top:0;bottom:0;left:0;width:0;border-radius:999px;background:var(--tint);box-shadow:inset 0 0 0 1px var(--indring);transition:left .55s cubic-bezier(.34,1.4,.5,1),width .55s cubic-bezier(.34,1.4,.5,1)}
      .ind.snap{transition:none}
      .tab{position:relative;z-index:1;flex:0 0 auto;height:44px;padding:0;border:0;border-radius:999px;background:transparent;color:var(--t3);font-size:clamp(12px,3.4vw,14px);font-weight:500;cursor:pointer;transition:color .3s ease}
      .tab:hover{color:var(--ink)}
      .tab[aria-current=page]{color:var(--acct2);font-weight:600}
      .bar-div{width:1px;height:22px;margin:0 4px 0 6px;background:var(--line2)}
      .theme-btn{flex:none;display:flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:0;border-radius:50%;background:transparent;color:var(--t3);cursor:pointer;transition:background .2s ease,color .2s ease}
      .theme-btn:hover{color:var(--ink);background:var(--surf2)}
      .th-icon{animation:thIcon .55s cubic-bezier(.34,1.56,.5,1) backwards}
      [data-ol-theme=light] .th-sun,[data-ol-theme=dark] .th-moon{display:none}
      /* first-load intro: orange dot stretches into the glass bar */
      .intro .bar{animation:bar1 1.2s linear 2.2s backwards}
      .intro .nv-in{animation:nvIn .5s ease-out var(--d,0s) backwards}

      /* ================= SCREENS ================= */
      .screen{display:none}
      .screen.active{display:block;animation:screenIn .55s cubic-bezier(.22,.61,.36,1) backwards}
      #home.active{display:flex}
      .screen.exiting,.foot.exiting{animation:screenOut .24s cubic-bezier(.4,0,.6,1) both;pointer-events:none}
      .page{max-width:1200px;margin:0 auto;padding:150px 24px 96px}
      .page-edu{max-width:1160px}
      .sec-head{display:flex;flex-direction:column;gap:10px;margin-bottom:40px}
      .sec-head.tight{margin-bottom:28px}
      .sec-title{margin:0;font-size:clamp(40px,5vw,64px);font-weight:800;letter-spacing:-.045em;line-height:1}
      .h3{margin:0;font-size:26px;font-weight:700;letter-spacing:-.025em}
      .kick{margin:0 0 10px;font-size:12px;letter-spacing:.12em;color:var(--t3)}
      .count{font-size:12px;color:var(--t3)}
      .card{border-radius:28px;border:1px solid var(--line);background:var(--surf);box-shadow:var(--shadow)}
      .tag{padding:4px 10px;border-radius:999px;background:var(--tint);color:var(--acct2)}
      .acc{color:var(--accg)}
      .fx-rise{animation:mRise .9s cubic-bezier(.16,1,.3,1) var(--d,0s) backwards}
      .fx-pop{animation:gPop .65s cubic-bezier(.34,1.4,.5,1) var(--d,0s) backwards}

      /* buttons */
      .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:50px;padding:0 26px;border-radius:999px;border:1px solid transparent;font-size:15px;font-weight:600;text-decoration:none;white-space:nowrap;cursor:pointer;transition:background .2s ease,border-color .2s ease,color .2s ease}
      .btn-sm{height:48px;padding:0 22px}
      .btn-primary{background:var(--acc);color:var(--onacc);font-weight:700;box-shadow:0 10px 28px rgba(255,106,61,.26)}
      .btn-primary:hover{background:#ff8458;color:var(--onacc)}
      .btn-ghost{border-color:var(--line2);background:var(--ghostbg);color:var(--ink)}
      .btn-ghost:hover{border-color:var(--line3);background:var(--surf2)}

      /* photo slot: label shows until a real image loads over it */
      .ph{position:relative;display:flex;align-items:center;justify-content:center;padding:0 16px;background:var(--ph);overflow:hidden;font-size:11.5px;color:var(--t3);text-align:center}
      .ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
      .ph-dash{border:1px dashed var(--line3)}
      .ph-dash:has(img){border-style:solid;border-color:var(--line)}
      .ph:has(>img)>span:first-child{visibility:hidden}
      /* CAD screenshots: shown whole on a light viewport in both themes */
      .ph.cad{background:radial-gradient(120% 90% at 50% 35%,var(--cad1),var(--cadbg))}
      .ph.cad img{object-fit:contain;padding:5%;mix-blend-mode:multiply}
      /* any photo marked data-zoom opens the full-screen viewer */
      [data-zoom]{cursor:zoom-in}
      .zoom-hint{position:absolute;top:12px;right:12px;z-index:2;display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:var(--arrowbg);color:var(--ink);box-shadow:var(--shadow);opacity:0;transform:scale(.85);transition:opacity .25s ease,transform .25s cubic-bezier(.34,1.56,.5,1);pointer-events:none}
      [data-zoom]:hover .zoom-hint,[data-zoom]:focus-visible .zoom-hint{opacity:1;transform:none}
      .ph:not(:has(>img)) .zoom-hint{display:none}
      .ph:not(:has(>img))[data-zoom]{cursor:default}
      @media (hover:none){.zoom-hint{opacity:.9;transform:none}}

      /* company logos (white tile so every brand reads in both themes) */
      .logo-tile{flex:none;display:flex;align-items:center;justify-content:center;height:64px;min-width:64px;padding:10px 14px;border-radius:16px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow)}
      .logo-tile img{display:block;height:100%;width:auto;max-width:150px;object-fit:contain}
      .logo-tile.big{height:96px;min-width:96px;padding:16px 22px;border-radius:22px}
      .logo-tile.big img{max-width:240px}

      /* bullet lists */
      .bul{display:flex;flex-direction:column;gap:13px;margin:24px 0 0;padding:22px 0 0;border-top:1px solid var(--line);list-style:none}
      .bul li{display:grid;grid-template-columns:6px minmax(0,1fr);gap:14px;align-items:start;font-size:15px;line-height:1.6;color:var(--t2)}
      .bul li::before{content:'';width:6px;height:6px;margin-top:9px;border-radius:50%;background:var(--acc);box-shadow:var(--glow)}
      .bul-plain{border-top:0;padding-top:0;margin-top:18px;gap:10px}
      .bul-sm li{font-size:14.5px;line-height:1.55;gap:12px}
      .bul-sm li::before{margin-top:8px;box-shadow:none}

      /* ================= HOME ================= */
      #home{position:relative;flex-direction:column;overflow:hidden}
      .hero{position:relative;display:flex;flex-direction:column;min-height:100vh;min-height:100svh;overflow:hidden}
      /* scroll cue at the bottom of the hero; fades once you start scrolling */
      .cue{position:absolute;left:50%;bottom:max(26px,env(safe-area-inset-bottom,0px));z-index:3;display:flex;flex-direction:column;align-items:center;gap:2px;margin-left:-50px;width:100px;padding:6px 0;border:0;background:none;color:var(--t3);font-size:13px;font-weight:600;letter-spacing:.02em;cursor:pointer;transition:opacity .4s ease,color .2s ease}
      .cue svg{animation:cueBob 1.8s ease-in-out infinite}
      .cue:hover{color:var(--acct)}
      .cue.gone{opacity:0;pointer-events:none}
      .cue.gone svg{animation-play-state:paused}

      /* ================= ABOUT ================= */
      .about{position:relative;border-top:1px solid var(--line);background:var(--surf)}
      .about-in{max-width:1200px;margin:0 auto;padding:110px 24px 110px}
      .about-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(36px,5vw,72px);align-items:center}
      .about-me{margin:0}
      .about-photo{position:relative;aspect-ratio:4/5;border-radius:28px;overflow:hidden;border:1px solid var(--line);box-shadow:var(--shadowL);transition:transform .5s cubic-bezier(.2,.7,.2,1),box-shadow .4s ease}
      .about-photo img{object-position:50% 30%;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
      .about-photo:hover{box-shadow:var(--shadowH)}
      .about-photo:hover img{transform:scale(1.03)}
      .about-txt .kick{margin:0 0 12px;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--acct)}
      .about-title{margin:0 0 22px;font-size:clamp(40px,5vw,64px);font-weight:800;letter-spacing:-.045em;line-height:1}
      .about-p{margin:0 0 16px;max-width:58ch;font-size:17px;line-height:1.65;color:var(--t2);text-wrap:pretty}
      .about .hobbies{margin-top:80px;padding-top:0;border-top:0}
      .about .hob-front,.about .hob-back{border-color:var(--line2)}
      /* reveal on scroll (only when JS is running; content is visible without it) */
      .rv{transition:opacity .8s cubic-bezier(.16,1,.3,1) var(--d,0s),transform .8s cubic-bezier(.16,1,.3,1) var(--d,0s)}
      html.rv-on .rv:not(.in){opacity:0;transform:translateY(26px)}
      .h-spot{position:absolute;left:50%;top:46%;width:1100px;height:720px;margin:-360px 0 0 -550px;border-radius:50%;background:radial-gradient(closest-side,var(--spot),var(--spot2) 55%,transparent);pointer-events:none}
      .h-dots{position:absolute;inset:0;background-image:radial-gradient(var(--dots) 1px,transparent 1.2px);background-size:28px 28px;-webkit-mask-image:radial-gradient(ellipse 60% 55% at 50% 48%,#000 20%,transparent 75%);mask-image:radial-gradient(ellipse 60% 55% at 50% 48%,#000 20%,transparent 75%);pointer-events:none}
      .h-inner{position:relative;z-index:2;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:150px 24px 110px}
      .h-name{margin:0;display:flex;flex-direction:column;align-items:center;font-weight:800;font-size:clamp(44px,10.6vw,152px);line-height:.9}
      .h-line{display:block;white-space:nowrap;letter-spacing:-.045em;color:transparent;background-size:300% 100%;background-position:0% 0;-webkit-background-clip:text;background-clip:text}
      .h-line-1{background-image:linear-gradient(90deg,var(--name1) 0%,var(--name1) 40%,var(--name1t) 60%)}
      .h-line-2{background-image:linear-gradient(90deg,var(--name2) 0%,var(--name2) 40%,var(--name2t) 60%)}
      .h-hair{position:relative;width:min(600px,80%);height:1px;margin:44px 0 28px;background:linear-gradient(90deg,transparent,var(--hair) 30%,var(--hair) 70%,transparent)}
      .h-hair span{position:absolute;left:50%;top:-3px;width:7px;height:7px;margin-left:-3.5px;border-radius:50%;background:var(--acc);box-shadow:var(--dotglow2)}
      .h-meta{margin:0;display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:10px 16px;font-size:19px;font-weight:500;color:var(--t2)}
      .h-sep{width:4px;height:4px;border-radius:50%;background:var(--acc)}
      .h-cta{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:44px}
      /* hero load-in (full on first visit, quick when you come back to Home) */
      .hx{animation-fill-mode:backwards;animation-delay:var(--d,0s)}
      .hx-spot{animation-name:spot;animation-duration:1.8s;animation-timing-function:cubic-bezier(.16,1,.3,1)}
      .hx-dots{animation-name:fade;animation-duration:1.6s;animation-timing-function:ease-out}
      .hx-wipe{animation-name:wipe;animation-duration:1.5s;animation-timing-function:cubic-bezier(.5,0,.2,1)}
      .hx-hair{transform-origin:center;animation-name:hair;animation-duration:1s;animation-timing-function:cubic-bezier(.65,0,.35,1)}
      .hx-rise{animation-name:rise;animation-duration:.9s;animation-timing-function:cubic-bezier(.16,1,.3,1)}
      html:not(.intro) .hx{animation-delay:.05s}
      html:not(.intro) .hx-wipe,html:not(.intro) .hx-spot{animation-duration:.9s}

      /* ================= EDUCATION ================= */
      /* Education reads in the body face, no mono */
      .page-edu .kick{margin:0;font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--t3)}
      .block{margin-top:56px}
      .block-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:16px}
      .block-title{margin-bottom:16px}
      .g-me{--c:var(--g-me)}.g-math{--c:var(--g-math)}.g-cs{--c:var(--g-cs)}.g-eng{--c:var(--g-eng)}.g-sci{--c:var(--g-sci)}.g-gen{--c:var(--g-gen)}
      .audit-btn{gap:8px}
      .audit-btn:hover{border-color:var(--accg);color:var(--acct2)}

      /* degree banner */
      .edu-banner{display:flex;flex-wrap:wrap;align-items:center;gap:24px;padding:24px 28px}
      .edu-logo{height:104px;min-width:104px;padding:14px 18px;border-radius:24px;box-shadow:none}
      .edu-id{flex:999 1 320px;min-width:0;display:flex;flex-direction:column;gap:6px}
      .edu-name{margin:0;font-size:clamp(24px,2.6vw,30px);font-weight:800;letter-spacing:-.03em;line-height:1.1;text-wrap:balance}
      .edu-deg{margin:0;font-size:16px;font-weight:500;color:var(--t2)}
      .edu-stats{flex:1 1 auto;display:flex;flex-wrap:wrap;margin:0}
      .es{display:flex;flex-direction:column-reverse;gap:4px;padding:4px 22px}
      .es+.es{border-left:1px solid var(--line)}
      .es-num{margin:0;font-size:28px;font-weight:800;letter-spacing:-.03em;line-height:1.1;font-variant-numeric:tabular-nums}
      .es-acc{color:var(--acct)}
      .es-lbl{font-size:12.5px;color:var(--t3)}

      /* coursework timeline: semester dots, then that semester's classes as bubbles */
      .ct{padding:22px 26px 28px}
      .ct-scroll{overflow-x:auto;margin:-8px -8px 0;padding:8px 8px 6px;scrollbar-width:none}
      .ct-scroll::-webkit-scrollbar{display:none}
      .ct-line{position:relative;display:flex;justify-content:space-between;gap:10px;min-width:780px}
      .ct-rail{position:absolute;left:24px;right:24px;top:50%;height:2px;margin-top:-1px;border-radius:1px;background:var(--line2)}
      .ct-node{position:relative;flex:0 1 118px;min-width:0;display:flex;flex-direction:column;align-items:center;gap:3px;padding:12px 10px 11px;border-radius:18px;border:1px solid var(--line2);background:var(--surf);color:var(--ink);cursor:pointer;transition:background .25s ease,border-color .25s ease,box-shadow .3s ease,transform .3s cubic-bezier(.34,1.56,.5,1)}
      .ct-node:hover{transform:translateY(-3px);border-color:rgba(232,80,31,.4);box-shadow:var(--shadow)}
      .ct-node[aria-pressed=true]{background:linear-gradient(var(--tint),var(--tint)),var(--surf);border-color:var(--accg);box-shadow:0 0 0 1px var(--accg),var(--glow)}
      .ct-dot{display:none}
      .ct-node.is-now .ct-dot{display:block;position:absolute;top:8px;right:9px;width:7px;height:7px;border-radius:50%;background:var(--greendot);box-shadow:0 0 0 0 var(--greendot);animation:ctLive 2.2s ease-out infinite}
      @keyframes ctLive{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--greendot) 55%,transparent)}70%,100%{box-shadow:0 0 0 7px transparent}}
      .ct-lbl{font-size:14px;font-weight:700;white-space:nowrap;transition:color .25s ease}
      .ct-node[aria-pressed=true] .ct-lbl{color:var(--acct)}
      .ct-sub{font-size:12px;color:var(--t3);white-space:nowrap}
      .ct-node[aria-pressed=true] .ct-sub{color:var(--acct2)}
      @media (prefers-reduced-motion:reduce){.ct-node.is-now .ct-dot{animation:none}}
      .ct-panel{display:flex;flex-direction:column;gap:16px;margin-top:18px;padding-top:22px;border-top:1px solid var(--line)}
      .ct-panel:not([hidden]){animation:sIn .5s cubic-bezier(.16,1,.3,1)}
      .ct-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:6px 12px}
      .ct-title{font-size:20px;font-weight:800;letter-spacing:-.02em}
      .bubbles{display:flex;flex-wrap:wrap;gap:10px}
      .bub{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:6px 14px 6px 6px;border-radius:999px;border:1px solid var(--line2);background:var(--surf);color:var(--ink);font-size:14.5px;font-weight:500;line-height:1.3;text-decoration:none;transition:border-color .2s ease,background .2s ease,transform .25s cubic-bezier(.34,1.56,.5,1)}
      a.bub:hover{border-color:var(--c);background:color-mix(in srgb,var(--c) 8%,var(--surf));color:var(--ink);transform:translateY(-2px)}
      .bub-code{flex:none;padding:6px 11px;border-radius:999px;background:color-mix(in srgb,var(--c) 14%,transparent);color:var(--c);font-size:12.5px;font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}
      .bub.has-grade{padding-right:6px}
      .bub-code{display:inline-flex;align-items:center;gap:6px}
      .bub-ic{flex:none;width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;transition:transform .45s cubic-bezier(.34,1.7,.5,1)}
      .bub:hover .bub-ic{transform:rotate(-10deg) scale(1.22)}
      .bub-grade{flex:none;min-width:30px;padding:5px 9px;border-radius:999px;background:var(--surf2);color:var(--ink);font-size:12.5px;font-weight:700;text-align:center;font-variant-numeric:tabular-nums}

      /* skills: 2×2 cards; a picked card flies into the centred dialog */
      @media (max-width:760px){
        .edu-logo{height:84px;min-width:84px}
        .es:first-child{padding-left:0}
      }
      /* skills: four groups of chips, each with a small looping scene */
      .skl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
      .skc{padding:20px 22px 22px;transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s ease,border-color .35s ease}
      .skc:hover{transform:translateY(-3px);box-shadow:var(--shadowH);border-color:rgba(232,80,31,.3)}
      .skc-head{display:flex;align-items:center;gap:14px;margin-bottom:16px}
      .skc-art{flex:none;display:flex;align-items:center;justify-content:center;width:66px;height:54px;border-radius:16px;background:var(--tint);color:var(--acct)}
      .ka{width:50px;height:38px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
      .skc-name{flex:1;min-width:0;margin:0;font-size:19px;font-weight:800;letter-spacing:-.02em;line-height:1.2;text-wrap:balance}
      .skc-chips{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}
      .chip{display:inline-flex;align-items:center;gap:8px;min-height:36px;padding:0 14px 0 11px;border-radius:999px;border:1px solid var(--line2);background:var(--chipbg);color:var(--t5);font-size:13.5px;font-weight:600;letter-spacing:-.005em;cursor:default;transition:border-color .2s ease,background .2s ease,color .2s ease,transform .25s cubic-bezier(.2,.7,.2,1)}
      .chip:hover{transform:translateY(-2px);border-color:var(--accg);background:var(--tint);color:var(--acct2)}
      .chip-ic{display:inline-flex;align-items:center;gap:4px;color:var(--t3);transition:color .2s ease}
      .chip:hover .chip-ic{color:var(--acct)}
      .chip-ic svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
      .lg{display:block;width:16px;height:16px;background:currentColor;-webkit-mask:var(--i) center/contain no-repeat;mask:var(--i) center/contain no-repeat}
      /* header scenes */
      /* draw-in: pathLength=1 and a 1-2 dash, hidden at ±1.01, so a fully hidden line leaves no round-cap dot */
      .ka-draw,.ka-type,.ka-layer{stroke-dasharray:1 2;stroke-dashoffset:1.01}
      .ka-draw{animation:kaDraw 5s cubic-bezier(.65,0,.35,1) infinite}
      .ka-d2{animation-delay:.35s}
      .ka-d3{animation-delay:.6s}
      @keyframes kaDraw{0%{stroke-dashoffset:1.01}40%,78%{stroke-dashoffset:0}100%{stroke-dashoffset:-1.01}}
      .ka-dot{stroke-width:2.6}
      .ka-type{animation:kaType 4.2s steps(7,end) infinite}
      .ka-t2{animation-delay:.5s}
      .ka-t3{animation-delay:1s}
      .ka-caret{animation:kaBlink 1s steps(1) infinite}
      @keyframes kaType{0%{stroke-dashoffset:1.01}22%,82%{stroke-dashoffset:0}100%{stroke-dashoffset:-1.01}}
      @keyframes kaBlink{50%{opacity:0}}
      /* print head: the gantry (rail + head) steps up one layer at a time, and the
         nozzle tip tracks the end of the line being laid, all on one 5s clock.
         Nozzle tip sits at x=32, so translateX = line x − 32. */
      .ka-rail{stroke-width:1.6;opacity:.6}
      .ka-noz rect,.ka-noz path{stroke-width:1.8}
      .ka-bead{stroke-width:2.2 !important}
      .ka-z,.ka-noz,.ka-l2,.ka-l3{animation-duration:5s;animation-iteration-count:infinite;animation-timing-function:linear}
      .ka-z{animation-name:kaZ}
      .ka-noz{animation-name:kaX}
      .ka-l2{animation-name:kaL2}
      .ka-l3{animation-name:kaL3}
      /* layer 2 (y 36, x 18→46) from 0–36%, travel, layer 3 (y 32.5, x 20→44) from 42–76%, lift, reset */
      @keyframes kaX{
        0%{transform:translateX(-14px)}
        36%{transform:translateX(14px);animation-timing-function:ease-in-out}
        42%{transform:translateX(-12px)}
        76%{transform:translateX(12px);animation-timing-function:ease-in-out}
        100%{transform:translateX(-14px)}
      }
      @keyframes kaZ{
        0%,36%{transform:translateY(3.4px);animation-timing-function:ease-in-out}
        42%,76%{transform:translateY(0);animation-timing-function:ease-in-out}
        84%{transform:translateY(-3px);animation-timing-function:ease-in-out}
        100%{transform:translateY(3.4px)}
      }
      @keyframes kaL2{
        0%{stroke-dashoffset:1;opacity:1}
        36%,86%{stroke-dashoffset:0;opacity:1}
        96%{stroke-dashoffset:0;opacity:0}
        97%,100%{stroke-dashoffset:1.01;opacity:0}
      }
      @keyframes kaL3{
        0%,41.9%{stroke-dashoffset:1.01;opacity:1}
        42%{stroke-dashoffset:1;opacity:1}
        76%,86%{stroke-dashoffset:0;opacity:1}
        96%{stroke-dashoffset:0;opacity:0}
        97%,100%{stroke-dashoffset:1.01;opacity:0}
      }
      .ka-grid{stroke-width:1;stroke-dasharray:2 3;opacity:.45}
      .ka-wave{animation:kaWave 1.4s linear infinite}
      @keyframes kaWave{to{transform:translateX(-20px)}}
      @media (max-width:760px){.skl{grid-template-columns:minmax(0,1fr)}.skc-name{font-size:18px}}
      @media (prefers-reduced-motion:reduce){.ka *{animation:none !important;opacity:1 !important;stroke-dashoffset:0 !important}}
      .grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:16px}

      /* ================= EXPERIENCE ================= */
      .xp{display:flex;flex-wrap:wrap;align-items:flex-start;gap:28px}
      /* timeline: [year / months] [rail + dot] [card] */
      .tl{position:relative;flex:1 1 400px;max-width:470px;padding:6px 0}
      .tl-spine{position:absolute;left:89px;top:6px;bottom:6px;width:2px;border-radius:2px;background:var(--line2);transform-origin:center top;animation:tSpine 1.2s cubic-bezier(.65,0,.35,1) .2s backwards}
      .tl-fill{position:absolute;left:89px;top:6px;width:2px;border-radius:2px;background:linear-gradient(180deg,#ff6a3d,rgba(255,106,61,.55));box-shadow:var(--fillglow);transition:height .6s cubic-bezier(.32,1.1,.36,1)}
      .tl-list{display:flex;flex-direction:column;gap:8px}
      .t-entry{position:relative;display:grid;grid-template-columns:64px 32px minmax(0,1fr);column-gap:10px;align-items:center;width:100%;min-height:88px;padding:0;border:0;background:none;text-align:left;cursor:pointer}
      .t-rail{position:relative;height:100%}
      .t-dot{position:absolute;left:10px;top:calc(50% - 6px);width:12px;height:12px;border-radius:50%;border:2px solid var(--dotoff);background:var(--bg);transition:background .3s ease,border-color .3s ease,box-shadow .3s ease,transform .3s cubic-bezier(.34,1.56,.5,1)}
      .t-entry.reached .t-dot{border-color:var(--acc)}
      .t-entry[aria-pressed=true] .t-dot{background:var(--acc);box-shadow:var(--dotglow)}
      .t-entry:hover .t-dot{transform:scale(1.25)}
      .t-card{display:flex;align-items:center;justify-content:space-between;gap:12px;min-width:0;padding:13px 16px;border-radius:16px;border:1px solid transparent;background:transparent;transition:background .3s ease,border-color .3s ease,box-shadow .3s ease}
      .t-entry:hover .t-card{background:var(--surf)}
      .t-entry[aria-pressed=true] .t-card{border-color:rgba(232,80,31,.4);background:var(--surf);box-shadow:var(--shadow)}
      .t-when{display:flex;flex-direction:column;align-items:flex-end;gap:3px;text-align:right}
      .t-yr{font-size:15px;font-weight:700;letter-spacing:-.01em;font-variant-numeric:tabular-nums;color:var(--t2);white-space:nowrap;transition:color .3s ease}
      .t-mo{font-size:11px;color:var(--t3);white-space:nowrap}
      .t-entry[aria-pressed=true] .t-yr{color:var(--acct)}
      .t-entry:hover .t-yr{color:var(--ink)}
      .t-txt{display:flex;flex-direction:column;gap:3px;min-width:0}
      .t-mwhen{display:none;font-size:11.5px;color:var(--t3)}
      /* company logo chip on each timeline card: muted until that job is picked or hovered */
      .t-logo{flex:none;display:flex;align-items:center;justify-content:center;height:26px;max-width:76px;padding:3px 7px;border-radius:8px;background:#fff;border:1px solid var(--line);transition:box-shadow .3s ease,transform .3s cubic-bezier(.34,1.56,.5,1)}
      .t-logo img{display:block;height:100%;width:auto;max-width:62px;object-fit:contain;filter:grayscale(1);opacity:.6;transition:filter .35s ease,opacity .35s ease}
      .t-entry:hover .t-logo img,.t-entry[aria-pressed=true] .t-logo img{filter:none;opacity:1}
      .t-entry[aria-pressed=true] .t-logo{box-shadow:var(--shadow);transform:scale(1.06)}
      .t-entry[aria-pressed=true] .t-mwhen{color:var(--acct)}
      .t-title{font-size:16px;font-weight:600;letter-spacing:-.01em;line-height:1.25;text-wrap:balance}
      .t-role{font-size:13px;line-height:1.35;color:var(--t3)}
      .stage-wrap{flex:999 1 600px;min-width:0}
      .stage{border-radius:30px;border:1px solid var(--line);background:var(--surf);box-shadow:var(--shadowL);overflow:hidden}
      .s-in{animation:sIn .7s cubic-bezier(.16,1,.3,1) var(--d,0s) backwards}
      .car{position:relative;aspect-ratio:16/9;background:var(--ph);border-bottom:1px solid var(--line);overflow:hidden;touch-action:pan-y}
      .car-track{display:flex;height:100%;transition:transform .6s cubic-bezier(.32,1.1,.36,1)}
      .slide{flex:0 0 100%;height:100%;font-size:12px}
      .slide:nth-child(3n+2){background:var(--ph2)}
      .slide:nth-child(3n){background:var(--ph3)}
      .car-btn{position:absolute;top:50%;margin-top:-22px;display:flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border-radius:50%;border:1px solid var(--line2);background:var(--arrowbg);color:var(--ink);box-shadow:var(--shadow);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);cursor:pointer;transition:background .2s ease,color .2s ease}
      .car-btn:hover{background:var(--acc);color:var(--onacc)}
      .car-prev{left:16px}
      .car-next{right:16px}
      .car-count{position:absolute;left:16px;bottom:14px;padding:5px 10px;border-radius:999px;background:var(--arrowbg);font-size:11.5px;color:var(--ink)}
      .car-dots{position:absolute;left:0;right:0;bottom:4px;display:flex;justify-content:center;pointer-events:none}
      .car-dot{pointer-events:auto;display:flex;align-items:center;justify-content:center;height:36px;padding:0 4px;border:0;background:none;cursor:pointer}
      .car-dot i{display:block;width:7px;height:6px;border-radius:3px;background:var(--dotoff);transition:width .35s cubic-bezier(.32,1.1,.36,1),background .3s ease}
      .car-dot[aria-current=true] i{width:22px;background:var(--acc)}
      .car.single .car-btn,.car.single .car-dots,.car.single .car-count{display:none}
      /* whole photo over a blurred copy of itself, so portrait shots aren't cropped */
      .slide .slide-bg,.xg-main .slide-bg{object-fit:cover;filter:blur(30px) saturate(1.3);transform:scale(1.2);opacity:.6}
      .slide .slide-img,.xg-main .slide-img{object-fit:contain}
      .car-btn,.car-count,.car-dots{z-index:3}
      /* job with no photos: the logo on a quiet branded panel */
      .slide.brand{flex-direction:column;gap:18px;background:var(--ph);cursor:default}
      .slide.brand::before{content:'';position:absolute;inset:0;background-image:radial-gradient(var(--dots) 1px,transparent 1.2px);background-size:22px 22px;-webkit-mask-image:radial-gradient(ellipse 55% 60% at 50% 50%,#000 10%,transparent 75%);mask-image:radial-gradient(ellipse 55% 60% at 50% 50%,#000 10%,transparent 75%)}
      .slide.brand .logo-tile{position:relative}
      .ph .logo-tile img{position:static;inset:auto;width:auto;height:100%;object-fit:contain}
      .slide.brand .brand-cap{position:relative;font-size:11.5px;letter-spacing:.1em;color:var(--t3)}
      .s-head{display:flex;align-items:center;gap:18px;margin-top:16px}
      .s-head .s-title{margin:0}
      .s-head .s-role{margin:8px 0 0}

      .stage-head{padding:clamp(24px,3vw,36px) clamp(24px,3vw,38px) 0}
      .stage-body{padding:clamp(20px,2.4vw,30px) clamp(24px,3vw,38px) clamp(24px,3vw,38px)}
      .stage-body .s-sum{margin-top:0}
      /* job photos: big one on the left, up to four on the right; click one to swap it in */
      .xg{display:grid;grid-template-columns:minmax(0,1fr) clamp(96px,19%,160px);gap:10px;margin:24px clamp(24px,3vw,38px) 0}
      .xg.solo{grid-template-columns:minmax(0,1fr)}
      .xg-main{position:relative;aspect-ratio:16/10;border-radius:18px;border:1px solid var(--line);overflow:hidden;background:var(--ph)}
      .xg-main img{transition:opacity .35s ease}
      .xg-main.swap .slide-img{animation:xgIn .5s cubic-bezier(.16,1,.3,1)}
      .xg-thumbs{display:grid;grid-template-rows:repeat(4,minmax(0,1fr));gap:10px;min-height:0}
      .xg-th{position:relative;display:block;width:100%;height:100%;min-height:0;padding:0;border:1px solid var(--line);border-radius:12px;background:var(--ph);overflow:hidden;cursor:pointer;transition:transform .3s cubic-bezier(.34,1.56,.5,1),border-color .25s ease,box-shadow .25s ease}
      .xg-th img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s cubic-bezier(.2,.7,.2,1),filter .3s ease}
      .xg-th:hover{transform:translateY(-2px);border-color:rgba(232,80,31,.5);box-shadow:var(--shadow)}
      .xg-th:hover img{transform:scale(1.06)}
      .xg-th.pop{animation:gPop .45s cubic-bezier(.34,1.4,.5,1)}
      .s-top{display:flex;flex-wrap:wrap;align-items:center;gap:12px}
      .badge-now{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:999px;border:1px solid var(--greenln);background:var(--greenbg);color:var(--green);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
      .badge-now i{width:6px;height:6px;border-radius:50%;background:var(--greendot);animation:mPulse 2.2s ease-in-out infinite}
      .s-title{margin:14px 0 0;font-size:clamp(30px,3.4vw,44px);font-weight:800;letter-spacing:-.04em;line-height:1.03}
      .s-role{margin:12px 0 4px;font-size:18px;font-weight:500;color:var(--acct)}
      /* job details shown once a job is opened */
      .s-facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px 24px;margin:20px 0 0;padding:16px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
      .s-facts div{display:flex;flex-direction:column;gap:4px;min-width:0}
      .s-facts dt{font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--t3)}
      .s-facts dd{margin:0;font-size:15.5px;font-weight:600;letter-spacing:-.01em;color:var(--ink)}
      .s-sum{margin:20px 0 0;max-width:64ch;font-size:16.5px;line-height:1.6;color:var(--t2);text-wrap:pretty}
      .tools{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
      .tool{padding:7px 13px;border-radius:999px;border:1px solid var(--line2);background:var(--chipbg);font-size:13px;color:var(--t5)}

      /* ================= PROJECTS ================= */
      .tiles{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:28px}
      .tile{flex:1 1 190px;min-width:0;display:flex;flex-direction:column;gap:10px;min-height:156px;padding:16px 18px;border-radius:22px;border:1px solid var(--line);background:var(--surf);color:var(--t4);box-shadow:var(--shadow);text-align:left;cursor:pointer;transition:border-color .3s ease,background .3s ease,color .3s ease,box-shadow .3s ease,transform .3s cubic-bezier(.2,.7,.2,1)}
      .tile-all{flex:0 1 150px;min-width:120px}
      .tile:hover{transform:translateY(-3px);color:var(--accg);border-color:rgba(232,80,31,.35)}
      .tile[aria-pressed=true]{color:var(--accg);border-color:rgba(232,80,31,.5);background:var(--tileon);box-shadow:var(--tileglow)}
      .tile-icon{flex:1;display:flex;align-items:center;justify-content:center}
      .tile-foot{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
      .tile-label{font-size:16px;font-weight:700;color:var(--t2)}
      .tile[aria-pressed=true] .tile-label{color:var(--ink)}
      .tile-count{font-size:11px;color:var(--t3)}
      .tile[aria-pressed=true] .tile-count{color:var(--acct)}
      /* tile icons */
      .sq-grid{display:grid;grid-template-columns:repeat(2,20px);gap:7px}
      .ic-sq{width:20px;height:20px;border-radius:6px;border:1.5px solid currentColor;animation:icSq 2.4s ease-in-out infinite}
      .ic-sq:nth-child(2){animation-delay:.3s}
      .ic-sq:nth-child(3){animation-delay:.9s}
      .ic-sq:nth-child(4){animation-delay:.6s}
      .ic-car{width:120px;height:88px}
      .ic-gears{width:112px;height:92px}
      .wheel-c{fill:var(--wheel)}
      .tiles.idle .tile-icon *{animation-play-state:paused !important}

      /* compact projects: banner feature + small cards */
      #projects .page{padding-top:122px}
      #projects .sec-head.tight{margin-bottom:22px}
      .feat.feat-bar{padding:0;border-radius:24px}
      .feat-bar .feat-in{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:0;height:clamp(220px,30vh,256px)}
      .feat-bar .feat-text{justify-content:center;padding:22px clamp(22px,2.4vw,32px)}
      .feat-bar .feat-kick{gap:8px;font-size:11px}
      .feat-bar .feat-title{margin-top:12px;font-size:clamp(24px,2.3vw,31px);line-height:1.08}
      .feat-bar .feat-desc{margin-top:8px;font-size:14.5px;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
      .feat-bar .feat-cta{margin-top:0;padding-top:16px}
      .feat.feat-bar .feat-img{min-height:0;height:100%;border:0;border-radius:0;border-left:1px solid var(--line);cursor:pointer;font:inherit;font-size:12px}
      .feat-bar .feat-img img{transition:transform .6s cubic-bezier(.2,.7,.2,1)}
      .feat-bar .feat-img:hover img{transform:scale(1.04)}
      .pc-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin:20px 4px 10px}
      .pc-h{margin:0;font-size:16px;font-weight:700;letter-spacing:-.02em}
      .pc-n{font-size:11px;color:var(--t3)}
      .pc-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;align-content:start;padding:8px 10px 14px;margin:-8px -10px -14px}
      .pc-card{display:flex;flex-direction:column;gap:10px;min-width:0;padding:0;border:0;background:none;color:var(--ink);text-align:left;cursor:pointer;transition:transform .35s cubic-bezier(.2,.7,.2,1)}
      .pc-card:hover{transform:translateY(-4px)}
      .pc-card[hidden]{display:none}
      .pc-img{width:100%;aspect-ratio:16/10;border-radius:16px;border:1px solid var(--line);box-shadow:var(--shadow);font-size:10.5px;transition:border-color .3s ease,box-shadow .3s ease}
      .pc-card:hover .pc-img{border-color:rgba(232,80,31,.45);box-shadow:var(--shadowH)}
      .pc-meta{display:flex;flex-direction:column;gap:3px;padding:0 2px;min-width:0}
      .pc-title{font-size:14.5px;font-weight:600;letter-spacing:-.01em;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .pc-sub{font-size:10.5px;color:var(--t3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .pc-card.pc-in{animation:pcIn .5s cubic-bezier(.2,.8,.2,1) var(--d,0s) backwards}
      @keyframes pcIn{from{opacity:0;transform:translateY(14px) scale(.97)}}
      .pc-more{display:flex;justify-content:center;margin-top:16px}
      .pc-more[hidden]{display:none}
      .pc-toggle{display:inline-flex;align-items:center;gap:6px;min-height:40px;padding:0 18px;border-radius:999px;border:1px solid var(--line2);background:var(--surf);font-size:14px;font-weight:600;color:var(--acct);cursor:pointer;transition:background .2s ease,border-color .2s ease}
      .pc-toggle:hover{border-color:var(--accg);background:var(--tint)}
      .pc-toggle svg{width:16px;height:16px;transition:transform .35s cubic-bezier(.2,.7,.2,1)}
      .pc-toggle[aria-expanded=true] svg{transform:rotate(180deg)}
      @media (max-width:899px){.pc-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
      @media (max-width:640px){
        .feat-bar .feat-in{grid-template-columns:1fr;height:auto}
        .feat.feat-bar .feat-img{order:-1;height:auto;aspect-ratio:16/9;border-left:0;border-bottom:1px solid var(--line)}
      }
      @media (prefers-reduced-motion:reduce){.pc-card.pc-in{animation:none}}

      /* sidebar layout: filter tiles stacked on the left, featured + projects on the right */
      @media (min-width:900px){
        .pj{display:grid;grid-template-columns:212px minmax(0,1fr);gap:24px;align-items:start}
        .pj .tiles{flex-direction:column;flex-wrap:nowrap;gap:8px;margin:0}
        .pj .tile,.pj .tile-all{flex:none;min-width:0;min-height:0;flex-direction:row;align-items:center;gap:12px;padding:7px 14px 7px 7px;border-radius:18px}
        .pj .tile:hover{transform:translateX(4px)}
        .pj .tile-label{font-size:15px}
        .pj .tile-icon{flex:none;width:56px;height:46px;border-radius:12px;background:var(--surf2);overflow:hidden}
        .pj .tile-icon>*{zoom:.42}
        .pj .tile-icon>.sq-grid{zoom:.62}
        .pj .tile[aria-pressed=true] .tile-icon{background:var(--tint)}
        .pj .tile-foot{flex:1;min-width:0}
      }
      .ic-wheel{transform-box:fill-box;transform-origin:center;animation:icSpin 2.6s linear infinite}
      .ic-gb{transform-box:fill-box;transform-origin:center;animation:icSpin 24s linear infinite}
      .ic-gs{transform-box:fill-box;transform-origin:center;animation:icSpinR 16s linear infinite}
      .cube-wrap{position:relative;width:84px;height:84px;perspective:420px}
      .ic-cube{position:absolute;left:20px;top:20px;width:44px;height:44px;transform-style:preserve-3d;transform:rotateX(-22deg) rotateY(35deg);animation:icCube 14s linear infinite}
      .ic-cube i{position:absolute;inset:0;border:1.5px solid currentColor}
      .ic-cube i:nth-child(1){transform:translateZ(22px)}
      .ic-cube i:nth-child(2){transform:rotateY(180deg) translateZ(22px)}
      .ic-cube i:nth-child(3){transform:rotateY(90deg) translateZ(22px)}
      .ic-cube i:nth-child(4){transform:rotateY(-90deg) translateZ(22px)}
      .ic-cube i:nth-child(5){transform:rotateX(90deg) translateZ(22px)}
      .ic-cube i:nth-child(6){transform:rotateX(-90deg) translateZ(22px)}
      .mon{width:110px;display:flex;flex-direction:column;align-items:center}
      .mon-screen{display:block;width:100%;border:1.5px solid currentColor;border-radius:8px;background:var(--screen);overflow:hidden}
      .mon-bar{display:flex;align-items:center;gap:4px;height:12px;padding:0 7px;border-bottom:1px solid var(--line2)}
      .mon-bar i{width:4px;height:4px;border-radius:50%;background:currentColor;opacity:.6}
      .mon-body{display:block;height:52px;overflow:hidden;padding:7px 8px}
      .ic-code{display:flex;flex-direction:column;gap:5px;padding-bottom:5px;animation:icCode 9s linear infinite}
      .cr{display:flex;gap:3px}
      .cr i{height:4px;border-radius:1px;background:var(--code)}
      .cr i.hi{background:currentColor}
      .mon-neck{display:block;width:14px;height:7px;border:1.5px solid currentColor;border-top:0}
      .mon-base{display:block;width:40px;height:5px;border:1.5px solid currentColor;border-radius:0 0 3px 3px}
      /* picked or hovered tile: the icon speeds up. Done in JS by easing each animation's
         playbackRate, so it keeps its place instead of snapping when the pointer leaves. */

      /* featured */
      .feat{position:relative;padding:clamp(24px,3vw,40px);border-radius:32px;border:1px solid var(--line);background:var(--surf);box-shadow:var(--shadowL);overflow:hidden}
      .feat-glow{position:absolute;left:-160px;bottom:-220px;width:520px;height:520px;border-radius:50%;background:radial-gradient(closest-side,var(--tint),transparent);pointer-events:none}
      .feat-in{position:relative;display:flex;flex-wrap:wrap;align-items:stretch;gap:32px}
      .feat-text{flex:1 1 360px;min-width:0;display:flex;flex-direction:column}
      .feat-kick{margin:0;display:flex;flex-wrap:wrap;gap:10px;align-items:center;font-size:12px;letter-spacing:.08em;color:var(--t3)}
      .feat-title{margin:22px 0 0;font-size:clamp(34px,3.8vw,52px);font-weight:800;letter-spacing:-.04em;line-height:1.02;text-wrap:balance}
      .feat-desc{margin:16px 0 0;max-width:46ch;font-size:17px;line-height:1.6;color:var(--t2);text-wrap:pretty}
      .feat .bul{margin-top:22px}
      .feat-cta{display:flex;flex-wrap:wrap;gap:10px;margin-top:auto;padding-top:28px}
      .feat-img{flex:1.3 1 440px;min-width:0;min-height:360px;border-radius:24px;font-size:12px}
      .p-in{animation:sIn .7s cubic-bezier(.16,1,.3,1) var(--d,0s) backwards}

      /* shelves (All) */
      .shelf{margin-top:64px}
      /* each category heading sits in its own bubble */
      .shelf-head,.cat-head{display:flex;align-items:center;gap:16px;margin-bottom:18px;padding:12px 12px 12px 12px;border-radius:24px;border:1px solid var(--line);background:var(--surf);box-shadow:var(--shadow)}
      .cat-ic{flex:none;display:flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:16px;background:var(--tint);color:var(--acct)}
      .cat-ic svg{width:26px;height:26px}
      .shelf-h{flex:1;min-width:0;margin:0}
      .count{white-space:nowrap}
      .see-all{flex:none;display:inline-flex;align-items:center;gap:4px;min-height:44px;padding:0 18px;border-radius:999px;border:1px solid var(--line2);background:var(--surf);font-size:15px;font-weight:600;color:var(--acct);cursor:pointer;transition:background .2s ease,border-color .2s ease,color .2s ease}
      .see-all:hover{border-color:var(--accg);background:var(--tint);color:var(--acct2)}
      .shelf-row{display:flex;gap:16px;margin-right:calc((100% - 100vw) / 2);padding:6px 24px 18px 0;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:var(--line3) transparent;animation:sSlide .9s cubic-bezier(.16,1,.3,1) var(--d,0s) backwards}
      .sh-card{flex:0 0 min(380px,82vw);display:flex;flex-direction:column;gap:12px;padding:0;border:0;background:none;color:var(--ink);text-align:left;scroll-snap-align:start;cursor:pointer;transition:transform .35s cubic-bezier(.2,.7,.2,1)}
      .sh-card:hover{transform:translateY(-5px)}
      .sh-img{width:100%;aspect-ratio:16/10;border-radius:22px;border:1px solid var(--line);background:var(--surf);box-shadow:var(--shadow);font-size:11px;transition:border-color .35s ease,box-shadow .35s ease}
      .sh-card:hover .sh-img{border-color:rgba(232,80,31,.45);box-shadow:var(--shadowH)}
      .sh-meta{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:0 4px}
      .sh-title{font-size:17px;font-weight:600;letter-spacing:-.015em}
      .sh-time{flex:none;font-size:11px;color:var(--t3)}

      /* category grid */
      .cat{margin-top:52px}
      .g-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(320px,100%),1fr));gap:16px}
      .g-card{display:flex;flex-direction:column;width:100%;padding:0;border-radius:24px;border:1px solid var(--line);background:var(--surf);box-shadow:var(--shadow);color:var(--ink);text-align:left;overflow:hidden;cursor:pointer;transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s ease,border-color .35s ease}
      .g-card:hover{transform:translateY(-5px);box-shadow:var(--shadowH);border-color:rgba(255,106,61,.35)}
      .g-img{width:100%;aspect-ratio:16/10;font-size:11px}
      .g-body{flex:1;display:flex;flex-direction:column;gap:8px;width:100%;padding:18px 20px 22px}
      .g-top{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
      .g-title{font-size:19px;font-weight:700;letter-spacing:-.02em}
      .g-time{flex:none;font-size:11px;color:var(--t3)}
      .g-desc{font-size:14.5px;line-height:1.55;color:var(--t2);text-wrap:pretty}
      .g-more{margin-top:auto;padding-top:10px;font-size:14.5px;font-weight:600;color:var(--acct)}
      /* coming back from a project: fade the overview in once instead of replaying every entrance */
      .ov.calm{animation:screenIn .55s cubic-bezier(.22,.61,.36,1) backwards}
      .ov.calm .ov-a{animation-duration:.01ms !important;animation-delay:0s !important}

      /* project page */
      .pd{animation:screenIn .55s cubic-bezier(.22,.61,.36,1) backwards}
      .back{display:inline-flex;align-items:center;gap:6px;min-height:44px;margin-bottom:32px;padding:0 18px 0 12px;border-radius:999px;border:1px solid var(--line2);background:var(--pillbg);color:var(--t2);font-size:14px;font-weight:600;cursor:pointer;transition:border-color .2s ease,color .2s ease,background .2s ease}
      .back:hover{color:var(--ink);border-color:var(--line3);background:var(--surf2)}
      .pd-kick{margin:0;display:flex;flex-wrap:wrap;gap:10px;align-items:center;font-size:12px;letter-spacing:.08em;color:var(--t3)}
      .pd-title{margin:18px 0 0;font-size:clamp(40px,5.2vw,68px);font-weight:800;letter-spacing:-.045em;line-height:1;text-wrap:balance}
      .pd-title:focus{outline:none}
      .pd-desc{margin:18px 0 0;max-width:60ch;font-size:18px;line-height:1.6;color:var(--t2);text-wrap:pretty}
      .pd-hero{display:flex;flex-wrap:wrap;gap:16px;margin-top:40px}
      .pd-sum{flex:1 1 340px;min-width:0;padding:30px 32px}
      .pd-sum h3,.pd-sec h3{margin:0;font-size:24px;font-weight:700;letter-spacing:-.025em}
      .pd-main{flex:1.6 1 480px;min-width:0;min-height:380px;border-radius:28px;font-size:12px}
      .pd-secs{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:16px;margin-top:16px}
      .pd-sec{overflow:hidden}
      .pd-sec .ph{aspect-ratio:16/9;border-bottom:1px solid var(--line)}
      .pd-sec-body{padding:24px 28px 28px}
      @media (min-width:900px){.pd-sec:only-child{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);align-items:center}.pd-sec:only-child .ph{aspect-ratio:16/10;border-bottom:0;border-right:1px solid var(--line)}}
      .pd-foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;margin-top:40px;padding-top:28px;border-top:1px solid var(--line)}
      .pd-foot .btn{white-space:normal;height:auto;min-height:48px;text-align:left}

      .pd-main,.pd-sec .ph{position:relative}
      .pd-sec .ph.cad{border-bottom-color:var(--line)}

      /* hobbies */
      .hobbies{margin-top:72px;padding-top:40px;border-top:1px solid var(--line)}
      .hob-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,42%),1fr));gap:40px clamp(22px,5vw,64px)}
      .hob-stack{aspect-ratio:1/1}
      .hob{position:relative;display:flex;flex-direction:column;gap:6px;min-width:0}
      .hob:hover{z-index:2}
      .hob-stack{position:relative;display:block;width:100%;aspect-ratio:4/5;margin-bottom:8px;padding:0;border:0;background:none;cursor:zoom-in}
      .hob-stack.empty{cursor:default}
      .hob-front,.hob-back{position:absolute;inset:0;border-radius:20px;overflow:hidden;border:1px solid var(--line);box-shadow:var(--shadow)}
      .hob-front{font-size:11px;transition:transform .45s cubic-bezier(.34,1.4,.5,1),box-shadow .35s ease,border-color .35s ease}
      .hob-back{background:var(--ph2);transition:transform .55s cubic-bezier(.34,1.4,.5,1)}
      .hob-back img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
      .hob-back.b1{transform:rotate(-3.5deg)}
      .hob-back.b2{transform:rotate(3deg)}
      /* hover: the stack fans out like a hand of photos */
      .hob-stack:hover .hob-front,.hob-stack:focus-visible .hob-front{transform:translateY(-6px);box-shadow:var(--shadowH);border-color:rgba(255,106,61,.4)}
      .hob-stack:hover .b1,.hob-stack:focus-visible .b1{transform:translate(-13%,1%) rotate(-9deg)}
      .hob-stack:hover .b2,.hob-stack:focus-visible .b2{transform:translate(13%,2%) rotate(8deg)}
      .hob-txt{display:flex;justify-content:center;padding:4px 4px 0;text-align:center}
      .hob-title{font-size:16px;font-weight:700;letter-spacing:-.015em}

      /* hobby doodles: tiny looping animations above each card */
      .hob-doodle{display:flex;justify-content:center;height:56px;margin:0 0 8px}
      .hob-scene{display:block;width:160px;height:56px;overflow:visible;fill:none;stroke:var(--t2);stroke-width:1.35;stroke-linecap:round;stroke-linejoin:round}
      .hob-scene .sc-ground,.hob-scene .sc-hill{stroke:var(--t4);stroke-width:1.1}
      .hob-scene .sc-acc{stroke:var(--acc);stroke-width:1.7}
      .hob-grid.idle .hob-scene *{animation-play-state:paused !important}
      .sc-ride .sc-pines path{fill:var(--t4);stroke:none;opacity:.6}
      .sc-ride .sc-spray{stroke:var(--t4);stroke-width:1;animation:scSpray .5s ease-out infinite}
      .sc-ride .sc-scarf{transform-box:fill-box;transform-origin:right center;animation:scFlap .35s ease-in-out infinite alternate}
      .sc-ride .sc-ski{animation:scSki 4.6s linear infinite}
      @keyframes scSki{
        0.0%{transform:translate(-8.0px,9.00px) rotate(0.0deg);opacity:0}
        5.8%{transform:translate(-6.3px,9.00px) rotate(0.0deg);opacity:1}
        11.5%{transform:translate(-2.8px,9.00px) rotate(0.0deg);opacity:1}
        17.2%{transform:translate(2.0px,9.00px) rotate(0.1deg);opacity:1}
        23.0%{transform:translate(7.9px,9.20px) rotate(3.8deg);opacity:1}
        28.8%{transform:translate(14.7px,9.88px) rotate(7.6deg);opacity:1}
        34.5%{transform:translate(22.4px,11.17px) rotate(11.3deg);opacity:1}
        40.2%{transform:translate(30.9px,13.14px) rotate(14.6deg);opacity:1}
        46.0%{transform:translate(40.2px,15.81px) rotate(17.3deg);opacity:1}
        51.8%{transform:translate(50.1px,19.12px) rotate(19.2deg);opacity:1}
        57.5%{transform:translate(60.8px,22.96px) rotate(20.2deg);opacity:1}
        63.2%{transform:translate(72.2px,27.13px) rotate(20.0deg);opacity:1}
        69.0%{transform:translate(84.1px,31.35px) rotate(18.5deg);opacity:1}
        74.8%{transform:translate(96.7px,35.22px) rotate(15.4deg);opacity:1}
        80.5%{transform:translate(109.9px,38.27px) rotate(10.3deg);opacity:1}
        86.2%{transform:translate(123.7px,39.89px) rotate(2.8deg);opacity:1}
        92.0%{transform:translate(138.0px,40.00px) rotate(0.0deg);opacity:0}
        92.1%,100%{opacity:0}
      }
      @keyframes scSpray{from{opacity:.9;translate:0 0}to{opacity:0;translate:-3px -1px}}
      @keyframes scFlap{from{rotate:-8deg}to{rotate:10deg}}
      .sc-pc .pc-win{stroke:var(--t4);stroke-width:.9}
      .sc-pc .pc-ring{stroke:var(--acc);stroke-width:1.1}
      .sc-pc .pc-blades path{stroke-width:1.05}
      .sc-pc .pc-hub{fill:var(--t2);stroke:none}
      .sc-pc .pc-blades{animation:pcSpin 1.1s linear infinite}
      .sc-pc .pc-gpu{stroke-width:1.05}
      .sc-pc .pc-strip{stroke-width:1.4;animation:pcGlow 2.4s ease-in-out infinite alternate}
      .sc-pc .pc-led{fill:var(--acc);stroke:none}
      @keyframes pcSpin{to{rotate:360deg}}
      @keyframes pcGlow{from{opacity:.45}to{opacity:1}}
      .sc-book .bk-sheet{fill:var(--surf);stroke-width:1.15}
      .sc-book .bk-txt{stroke:var(--t4);stroke-width:1}
      .sc-book .bk-cover{stroke:var(--t2);stroke-width:1.3}
      .sc-book .bk-ribbon{fill:var(--acc);stroke:none}
      /* one page lifts off the right, turns over the spine and settles on the left; the left side
         looks the same as the page underneath, so the loop restarts without a visible jump */
      .sc-book .bk-flip{transform-box:view-box;transform-origin:66px 0;animation:bkFlip 2.6s cubic-bezier(.55,0,.3,1) infinite}
      @keyframes bkFlip{
        0%,30%{transform:scale(1,1)}
        62%{transform:scale(.04,1.03)}
        92%,100%{transform:scale(-1,1)}
      }
      @media (prefers-reduced-motion: reduce){
        .hob-scene *{animation:none !important}
        .sc-ride .sc-ski{transform:translate(70px,26.34px) rotate(20.1deg);opacity:1}
      }

      /* project gallery */
      .pd-gal{margin-top:56px}
      .gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(220px,46%),1fr));align-items:start;grid-auto-flow:dense;gap:12px}
      .gal-item{position:relative;display:block;width:100%;aspect-ratio:4/5;padding:0;border:1px solid var(--line);border-radius:18px;background:var(--ph);overflow:hidden;cursor:zoom-in;transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s ease,border-color .35s ease}
      .gal-item img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
      .gal-item.cad{background:radial-gradient(120% 90% at 50% 35%,var(--cad1),var(--cadbg))}
      .gal-item.cad img{object-fit:contain;padding:8%;mix-blend-mode:multiply}
      .gal-item:hover{transform:translateY(-4px);box-shadow:var(--shadowH);border-color:rgba(255,106,61,.4)}
      .gal-item:hover img{transform:scale(1.04)}
      .gal-cap{position:absolute;left:0;right:0;bottom:0;padding:28px 12px 10px;background:linear-gradient(transparent,rgba(0,0,0,.55));color:#fff;font-size:12.5px;font-weight:500;text-align:left;opacity:0;transform:translateY(6px);transition:opacity .3s ease,transform .3s ease}
      .gal-item:hover .gal-cap,.gal-item:focus-visible .gal-cap{opacity:1;transform:none}
      .gal-item:nth-child(6n+1){grid-column:span 2;aspect-ratio:33/20}
      
      /* full-screen photo viewer */
      .lb{position:fixed;inset:0;width:100vw;height:100vh;height:100dvh;max-width:none;max-height:none;margin:0;padding:0;border:0;background:var(--lbbg);color:var(--ink);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);overflow:hidden}
      .lb::backdrop{background:transparent}
      .lb[open]{display:flex;align-items:center;justify-content:center;animation:hfBgIn .34s ease both}
      .lb.closing{animation:hfBgOut .34s ease both}
      /* opening and closing: the photo grows out of / shrinks back into the one you clicked;
         the blur and the controls ease in and out around it */
      .lb[open] .lb-btn,.lb[open] .lb-count,.lb[open] .lb-cap{animation:hfFade .3s .12s ease both}
      .lb.homing .lb-btn,.lb.homing .lb-count,.lb.homing .lb-cap,.lb.closing .lb-btn,.lb.closing .lb-count,.lb.closing .lb-cap{animation:hfFadeOut .18s ease both}
      .lb.flying .lb-img{animation:none;opacity:0}
      .lb-ghost{position:fixed;z-index:3;margin:0;overflow:hidden;pointer-events:none;box-shadow:0 30px 80px rgba(0,0,0,.35)}
      .lb-ghost img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;color:transparent}
      html.lb-open{overflow:hidden}
      /* hobby photos fan out of the stack into a grid, like a Dock folder opening */
      .hfan{position:fixed;inset:0;width:100vw;height:100vh;height:100dvh;max-width:none;max-height:none;margin:0;padding:0;border:0;background:transparent;color:var(--ink);overflow:hidden}
      .hfan::backdrop{background:transparent}
      .hf-bg{position:absolute;inset:0;background:var(--lbbg);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);animation:hfBgIn .34s ease both}
      /* closing: the blur holds while the photos fly home, then eases off once they've landed */
      .hfan.unblur .hf-bg{animation:hfBgOut .42s ease both}
      .hfan.closing .hf-close{animation:hfFadeOut .2s ease both}
      .hf-wrap{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;height:100%;padding:72px 16px 40px;box-sizing:border-box}
      .hf-title{margin:0;font-size:clamp(20px,2.4vw,26px);font-weight:700;letter-spacing:-.02em;animation:hfFade .4s .12s ease both}
      .hfan.closing .hf-title{animation:hfFadeOut .2s ease both}
      .hf-grid{--t:min(200px,calc((100vw - 120px) / 4),calc((100dvh - 230px) / 2));display:grid;grid-template-columns:repeat(var(--cols,4),var(--t));gap:clamp(12px,1.6vw,20px)}
      .hf-tile{position:relative;width:var(--t);aspect-ratio:1/1;padding:0;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:var(--ph2);box-shadow:var(--shadowH);cursor:zoom-in;transition:transform .3s cubic-bezier(.34,1.4,.5,1),box-shadow .3s ease}
      .hf-tile:hover,.hf-tile:focus-visible{transform:translateY(-4px) scale(1.03)}
      .hf-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;color:transparent}
      .hf-more{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.52);color:#fff;font-size:clamp(20px,2.4vw,28px);font-weight:700;letter-spacing:-.02em}
      .hf-close{z-index:2;animation:hfFade .3s .1s ease both}
      .hf-ghost{position:fixed;z-index:3;box-sizing:border-box;margin:0;border:1px solid var(--line);overflow:hidden;background:var(--ph2);box-shadow:var(--shadow);pointer-events:none}
      .hf-ghost img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;color:transparent}
      @media (max-width:640px){
        .hf-grid{--cols:2 !important;--t:min(170px,calc((100vw - 56px) / 2),calc((100dvh - 230px) / 4))}
      }
      @keyframes hfFade{from{opacity:0}to{opacity:1}}
      @keyframes hfFadeOut{from{opacity:1}to{opacity:0}}
      @keyframes hfBgIn{from{background-color:transparent;-webkit-backdrop-filter:blur(0);backdrop-filter:blur(0)}to{background-color:var(--lbbg);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}}
      @keyframes hfBgOut{from{background-color:var(--lbbg);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}to{background-color:transparent;-webkit-backdrop-filter:blur(0);backdrop-filter:blur(0)}}
      .lb-fig{display:flex;flex-direction:column;align-items:center;gap:14px;margin:0;padding:72px 84px 64px;max-width:100%;max-height:100%}
      .lb-img{display:block;max-width:min(1400px,100%);max-height:calc(100dvh - 170px);width:auto;height:auto;border-radius:14px;box-shadow:0 30px 80px rgba(0,0,0,.35);animation:lbPop .45s cubic-bezier(.16,1,.3,1) backwards;touch-action:pan-y}
      .lb-img.cad{background:#fff}
      .lb-cap{max-width:70ch;font-size:15px;font-weight:500;color:var(--t2);text-align:center}
      .lb-cap:empty{display:none}
      .lb-btn{position:absolute;display:flex;align-items:center;justify-content:center;width:48px;height:48px;padding:0;border-radius:50%;border:1px solid var(--line2);background:var(--arrowbg);color:var(--ink);cursor:pointer;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);transition:background .2s ease,color .2s ease,transform .2s ease}
      .lb-btn:hover{background:var(--acc);color:var(--onacc)}
      .lb-close{top:18px;right:18px}
      .lb-prev{left:18px;top:50%;margin-top:-24px}
      .lb-next{right:18px;top:50%;margin-top:-24px}
      .lb-count{position:absolute;top:30px;left:24px;font-size:12px;letter-spacing:.08em;color:var(--t3)}
      .lb.solo .lb-prev,.lb.solo .lb-next,.lb.solo .lb-count{display:none}
      @media (max-width:640px){
        .lb-fig{padding:68px 12px 84px}
        .lb-img{max-height:calc(100dvh - 190px);border-radius:10px}
        .lb-prev,.lb-next{top:auto;bottom:18px;margin-top:0}
        .lb-prev{left:calc(50% - 60px)}
        .lb-next{right:calc(50% - 60px)}
      }

      /* ================= FOOTER ================= */
      .foot{border-top:1px solid var(--line);padding:48px 24px 40px;animation:screenIn .55s cubic-bezier(.22,.61,.36,1) backwards}
      .foot-in{max-width:1200px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:22px}
      .socials{display:flex;flex-wrap:wrap;justify-content:center;gap:12px}
      .soc{--brand:var(--acc);--on:var(--onacc);position:relative;display:flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:50%;border:1px solid var(--line2);background:var(--surf);color:var(--t2);box-shadow:var(--shadow);text-decoration:none;transition:background .3s ease,color .3s ease,border-color .3s ease,transform .35s cubic-bezier(.34,1.56,.5,1),box-shadow .3s ease}
      .soc svg{position:relative;transition:transform .35s cubic-bezier(.34,1.56,.5,1)}
      /* brand colour fades in underneath the icon (works for gradients too) */
      .soc::before{content:'';position:absolute;inset:-1px;border-radius:50%;background:var(--brand);opacity:0;transform:scale(.6);transition:opacity .3s ease,transform .4s cubic-bezier(.34,1.56,.5,1)}
      .soc:hover,.soc:focus-visible{border-color:transparent;color:var(--on);transform:translateY(-4px);box-shadow:0 12px 28px rgba(0,0,0,.18)}
      .soc:hover::before,.soc:focus-visible::before{opacity:1;transform:none}
      .soc:hover svg{transform:scale(1.1)}
      .soc-gh{--brand:var(--ink);--on:var(--bg)}
      .soc-li{--brand:#0a66c2;--on:#fff}
      .soc-audit{--brand:#13294b;--on:#fff}
      .soc-tel{--brand:#22a55a;--on:#fff}
      /* label bubble above each button */
      .soc::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 10px);left:50%;padding:6px 10px;border-radius:8px;background:var(--ink);color:var(--bg);font-size:11.5px;white-space:nowrap;pointer-events:none;opacity:0;transform:translate(-50%,4px);transition:opacity .2s ease,transform .2s ease}
      .soc:hover::after,.soc:focus-visible::after{opacity:1;transform:translate(-50%,0)}
      .foot-meta{margin:0;font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--t3)}
      /* LinkedIn buttons turn LinkedIn blue on hover */
      .btn-li:hover{background:#0a66c2;border-color:#0a66c2;color:#fff}

      /* ================= RESPONSIVE ================= */
      @media (max-width:980px){
        /* timeline becomes a swipeable row above the stage */
        .tl{position:relative;top:auto;flex:1 1 100%;min-width:0;max-width:none;padding:0}
        .tl-spine,.tl-fill,.t-when{display:none}
        .t-mwhen{display:block}
        .tl-list{flex-direction:row;gap:10px;margin:0 -24px;padding:4px 24px 10px;overflow-x:auto;scroll-snap-type:x proximity;scroll-padding:0 24px;scrollbar-width:none}
        .tl-list::-webkit-scrollbar{display:none}
        .t-entry{flex:0 0 min(260px,72vw);height:auto;grid-template-columns:minmax(0,1fr);scroll-snap-align:start}
        .t-rail{display:none}
        .t-card{height:100%;border-color:var(--line);background:var(--surf)}
        .xp{gap:16px}
      }
      @media (max-width:900px){
        .about-in{padding:80px 24px}
        .about-grid{grid-template-columns:minmax(0,1fr);gap:36px}
        .about-photo{max-width:420px;aspect-ratio:1/1}
      }
      @media (max-width:640px){
        .page{padding:124px 24px 72px}
        .sec-head{margin-bottom:28px}
        .h-inner{padding:130px 20px 90px}
        .h-meta{font-size:15px;gap:8px 10px}
        .h3{font-size:22px}
        .h-cta{margin-top:36px}
        .btn{height:46px;padding:0 20px}
        .pd-sum{padding:26px 24px}
        .edu-banner,.ct{padding:22px 20px}
        .tiles{flex-wrap:nowrap;gap:10px;margin:0 -24px 24px;padding:6px 24px 14px;overflow-x:auto;scroll-snap-type:x proximity;scroll-padding:0 24px;scrollbar-width:none}
        .tiles::-webkit-scrollbar{display:none}
        .tile,.tile-all{flex:0 0 156px;min-width:0;scroll-snap-align:start}
        .feat{border-radius:26px}
        .feat-in{gap:24px}
        .feat-img{min-height:220px}
        .pd-main{min-height:240px}
        .stage{border-radius:24px}
        .xg{grid-template-columns:minmax(0,1fr)}
        .xg-thumbs{grid-template-rows:none;grid-template-columns:repeat(4,minmax(0,1fr))}
        .xg-th{aspect-ratio:1}
        .s-head{flex-direction:column;align-items:flex-start;gap:14px}
        .logo-tile{height:54px;min-width:54px;padding:8px 12px;border-radius:14px}
        .foot{padding:40px 24px 32px}
      }
      @media (max-width:380px){
        .h-meta{flex-direction:column;gap:4px}
        .h-sep{display:none}
      }

      /* ================= KEYFRAMES ================= */
      @keyframes themeReveal{from{clip-path:circle(0px at var(--tx,50%) var(--ty,50px))}to{clip-path:circle(170vmax at var(--tx,50%) var(--ty,50px))}}
      @keyframes screenIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
      @keyframes screenOut{from{opacity:1;transform:none}to{opacity:0;transform:translateY(-14px)}}
      @keyframes xgIn{from{opacity:0;transform:scale(1.03)}to{opacity:1;transform:none}}
      @keyframes cueBob{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}
      @keyframes nvIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
      @keyframes thIcon{from{opacity:0;transform:rotate(-120deg) scale(.4)}to{opacity:1;transform:none}}
      @keyframes bar1{
        0%{opacity:0;transform:scale(.3);background:#ff6a3d;border-color:#ff6a3d;clip-path:inset(0 calc(50% - 27px) round 999px);animation-timing-function:cubic-bezier(.2,.8,.3,1)}
        20%{opacity:1;transform:scale(1.1);background:#ff6a3d;border-color:#ff6a3d;clip-path:inset(0 calc(50% - 27px) round 999px);animation-timing-function:ease-in-out}
        30%{transform:scale(1);background:#ff6a3d;border-color:#ff6a3d;clip-path:inset(0 calc(50% - 27px) round 999px);animation-timing-function:cubic-bezier(.55,0,.25,1)}
        66%{transform:scale(1.05,.92);background:var(--glass);border-color:var(--glassln);clip-path:inset(0 0 round 999px);animation-timing-function:ease-in-out}
        80%{transform:scale(.985,1.03)}
        92%{transform:scale(1.004,1)}
        100%{opacity:1;transform:none;background:var(--glass);border-color:var(--glassln);clip-path:inset(0 0 round 999px)}
      }
      @keyframes spot{from{opacity:0;transform:translateX(-38%) scale(.55)}to{opacity:1;transform:none}}
      @keyframes fade{from{opacity:0}to{opacity:1}}
      @keyframes wipe{from{background-position:100% 0;transform:scale(1.07);letter-spacing:.02em;filter:blur(6px)}to{background-position:0% 0;transform:none;letter-spacing:-.045em;filter:blur(0)}}
      @keyframes hair{from{transform:scaleX(0);opacity:0}to{transform:scaleX(1);opacity:1}}
      @keyframes rise{from{opacity:0;transform:translateY(16px);filter:blur(8px)}to{opacity:1;transform:none;filter:blur(0)}}
      @keyframes mRise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
      @keyframes sSlide{from{opacity:0;transform:translateX(60px)}to{opacity:1;transform:none}}
      @keyframes gPop{from{opacity:0;transform:scale(.93) translateY(16px)}to{opacity:1;transform:none}}
      @keyframes sIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
      @keyframes mPulse{0%,100%{opacity:.5}50%{opacity:1}}
      @keyframes tSpine{from{transform:scaleY(0)}to{transform:scaleY(1)}}
      @keyframes icSpin{to{transform:rotate(360deg)}}
      @keyframes icSpinR{to{transform:rotate(-360deg)}}
      @keyframes lbIn{from{opacity:0}to{opacity:1}}
      @keyframes lbPop{from{opacity:0;transform:scale(.96) translateY(10px)}to{opacity:1;transform:none}}
      @keyframes icCube{from{transform:rotateX(-22deg) rotateY(0deg)}to{transform:rotateX(-22deg) rotateY(360deg)}}
      @keyframes icCode{from{transform:translateY(0)}to{transform:translateY(-50%)}}
      @keyframes icSq{0%,100%{opacity:.35}50%{opacity:1}}

      @media (prefers-reduced-motion: reduce){
        *,*::before,*::after{animation-duration:.01ms !important;animation-delay:0s !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
        ::view-transition-old(root),::view-transition-new(root){animation:none !important}
      }
    </style>
  </head>

  <body>
    <!-- ===================== NAV ===================== -->
    <header class="top">
      <nav class="bar" aria-label="Primary">
        <div class="tabs" id="navTabs">
          <span class="ind" id="navInd" aria-hidden="true"></span>
          {NAV.map((n, i) => (
            <button class="tab nv-in" type="button" data-nav={n.id} aria-current={i === 0 ? 'page' : undefined} style={`flex-basis:${n.w};--d:${(2.75 + i * 0.05).toFixed(2)}s`}>{n.label}</button>
          ))}
        </div>
        <span class="bar-div nv-in" aria-hidden="true" style="--d:2.95s"></span>
        <button class="theme-btn nv-in" id="themeBtn" type="button" aria-label="Switch to dark mode" title="Switch to dark mode" style="--d:3s">
          <svg class="th-icon th-moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z"></path></svg>
          <svg class="th-icon th-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path></svg>
        </button>
      </nav>
    </header>

    <main id="main">
      <!-- ===================== HOME ===================== -->
      <section id="home" class="screen active" aria-label="Home">
        <div class="hero">
        <div class="h-spot hx hx-spot" aria-hidden="true"></div>
        <div class="h-dots hx hx-dots" aria-hidden="true" style="--d:1s"></div>
        <div class="h-inner">
          <h1 class="h-name" aria-label="Oliver Lesiakowski">
            <span class="h-line h-line-1 hx hx-wipe" aria-hidden="true" style="--d:.3s">Oliver</span>
            <span class="h-line h-line-2 hx hx-wipe" aria-hidden="true" style="--d:.55s">Lesiakowski</span>
          </h1>
          <div class="h-hair hx hx-hair" aria-hidden="true" style="--d:1.25s"><span></span></div>
          <p class="h-meta">
            <span class="hx hx-rise" style="--d:1.55s">Mechanical Engineering</span>
            <span class="h-sep hx hx-rise" aria-hidden="true" style="--d:1.6s"></span>
            <span class="hx hx-rise" style="--d:1.65s">CS</span>
            <span class="h-sep hx hx-rise" aria-hidden="true" style="--d:1.7s"></span>
            <span class="hx hx-rise" style="--d:1.75s">UIUC 2028</span>
          </p>
          <div class="h-cta">
            <a class="btn btn-primary hx hx-rise" href={RESUME} target="_blank" rel="noopener noreferrer" style="--d:1.9s">Résumé ↗</a>
            <a class="btn btn-ghost btn-li hx hx-rise" href={LINKEDIN} target="_blank" rel="noopener noreferrer" style="--d:2s">LinkedIn ↗</a>
            <a class="btn btn-ghost hx hx-rise" href={`mailto:${EMAIL}`} style="--d:2.1s">Email</a>
          </div>
        </div>
        <button class="cue hx hx-rise" id="cue" type="button" style="--d:2.5s" aria-label="Scroll to About me">
          <span>About me</span>
