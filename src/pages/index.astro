  book: '<path d="M12 6.5c-2-1.5-5-2-8-1.5v13c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5V5c-3-.5-6 0-8 1.5zM12 6.5v13"/>',
  axes: '<path d="M12 13V3M12 13l8 5M12 13l-8 5"/><path d="M5 9c3 2.5 10 2.5 14-1"/>',
  pen: '<path d="M4 20l1-4L16 5l3 3L8 19z"/><path d="M14 7l3 3"/>',
  cap: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2 9 2 12 0v-5M22 9v5"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1"/>',
  integral: '<path d="M15.5 3.8c-1.5-1-3.6-.5-3.9 1.5L9.9 18.7c-.3 2-2.4 2.5-3.9 1.5"/>',
  proj: '<path d="M3 20h18"/><path d="M4 19C7 8 13 5 19.5 12.5" stroke-dasharray="2 2.6"/><circle cx="20" cy="15" r="1.7"/>',
  magnet: '<path d="M6 3v9a6 6 0 0 0 12 0V3h-4v9a2 2 0 0 1-4 0V3z"/><path d="M6 7h4M14 7h4"/>',
  laptop: '<rect x="4" y="5" width="16" height="11" rx="1.5"/><path d="M2 19h20"/>',
  speech: '<path d="M4 5h16v10H9l-5 4z"/><path d="M8 9h8M8 12h5"/>',
};
const COURSE_GLYPH = {
  'ME 320': 'heat', 'TAM 251': 'beam', 'ECE 205': 'circuit', 'NPRE 402': 'atom', 'GGIS 101': 'globe',
  'ME 310': 'flow', 'TAM 212': 'dyn', 'STAT 400': 'bell', 'CS 128': 'code',
  'ME 200': 'thermo', 'TAM 270': 'dfm', 'MATH 285': 'deriv', 'CS 124': 'code', 'HIST 104': 'music', 'ME 290': 'talk',
  'CHEM 104': 'flask', 'CHEM 105': 'tube',
  'ME 170': 'cube', 'TAM 211': 'truss', 'MATH 257': 'matrix', 'ECON 103': 'chart', 'POL 115': 'book',
  'MATH 241': 'axes', 'CHEM 102': 'flask', 'CHEM 103': 'tube', 'RHET 105': 'pen', 'ENG 100': 'cap', 'ENG 101': 'gear',
