              <div class="pd-hero fx-rise" style="--d:.08s">
                <section class="card pd-sum">
                  <p class="kick mono">HIGHLIGHTS</p>
                  <h3>Project summary</h3>
                  <ul class="bul bul-plain">
                    {p.bullets.map((b) => <li>{b}</li>)}
