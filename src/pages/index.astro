const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const ym = (v) => { const [y, m] = v.split('-').map(Number); return { y, m }; };
const plural = (n, w) => `${n} ${w}${n === 1 ? '' : 's'}`;
function timing(e) {
  const a = ym(e.start);
  const b = e.end ? ym(e.end) : null;
  const full = `${MON[a.m - 1]} ${a.y} – ${b ? `${MON[b.m - 1]} ${b.y}` : 'Present'}`;
  // short label for the timeline: the year (or year span) over the months
  const yr = !b ? String(a.y) : a.y === b.y ? String(a.y) : `${a.y} – ${String(b.y).slice(2)}`;
  const mo = `${MON[a.m - 1]} – ${b ? MON[b.m - 1] : 'Now'}`;
  let length = 'Ongoing';
  if (b) {
    const n = (b.y - a.y) * 12 + (b.m - a.m) + 1;
    const y = Math.floor(n / 12), m = n % 12;
    length = [y && plural(y, 'year'), m && plural(m, 'month')].filter(Boolean).join(', ');
  }
  return { full, yr, mo, length };
}
