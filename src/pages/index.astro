                </section>
                <div class:list={['pd-main ph ph-dash', { cad: p.cad }]} data-zoom={p.src} data-cap={p.title} tabindex="0" role="button" aria-label={`View photo: ${p.title}`}>
                  <span aria-hidden="true">{p.image}</span>
                  {p.src && <img src={p.src} alt={p.title} loading="lazy" decoding="async" onerror={FALLBACK} />}
                  <span class="zoom-hint" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg></span>
                </div>
              </div>
              <div class="pd-secs">
                {p.sections.map((s, k) => (
                  <section class="card pd-sec fx-rise" style={`--d:${(0.16 + k * 0.06).toFixed(2)}s`}>
                    <div class:list={['ph', { cad: s.cad }]} data-zoom={s.src} data-cap={s.title} tabindex="0" role="button" aria-label={`View photo: ${s.title}`}>
                      <span aria-hidden="true">{s.image}</span>
                      {s.src && <img src={sm(s.src)} data-full={s.src} alt={s.title} loading="lazy" decoding="async" onerror={FALLBACK} />}
                      <span class="zoom-hint" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg></span>
                    </div>
                    <div class="pd-sec-body">
                      <p class="kick mono">{s.label.toUpperCase()}</p>
                      <h3>{s.title}</h3>
                      <ul class="bul bul-plain">
                        {s.bullets.map((b) => <li>{b}</li>)}
                      </ul>
                    </div>
