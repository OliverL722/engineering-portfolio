          [{ opacity: 0, transform: "translateY(4px)" }, { opacity: 1, transform: "none" }],
          { duration: 400, delay: 500 + i * 50, easing: "ease-out", fill: "backwards" }));
        pill.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 450, delay: 900, fill: "backwards" });
      }
      function closeNav() {
        if (!navOpen) return;
        navOpen = false;
        const { w, h } = pillSize();
