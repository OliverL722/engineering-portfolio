      /* ---------- hero load-in: corners open out, letters rise, buttons stretch in, menu button pops ---------- */
      function runHeroIntro() {
        const root = document.documentElement;
        const frame = document.getElementById("heroFrame");
        const title = document.getElementById("heroTitle");
        // split the name into letters (each rises from behind its line)
        title.querySelectorAll(".ht-line").forEach((line) => {
          const txt = line.textContent.trim(); line.textContent = "";
          for (const ch of txt) { const s = document.createElement("span"); s.className = "ht-ch"; s.textContent = ch; line.appendChild(s); }
        });
        if (!root.classList.contains("intro")) return; // reduced motion, or the failsafe already fired
        const O = { fill: "backwards" };
        const fadeUp = (el, delay, dur = 600) => el && el.animate(
          [{ opacity: 0, transform: "translateY(10px)" }, { opacity: 1, transform: "none" }],
          { ...O, duration: dur, delay, easing: "ease-out" });

        // background
        document.querySelector(".grid-bg").animate([{ opacity: 0 }, { opacity: 1 }], { ...O, duration: 1000, delay: 200, easing: "ease-out" });
        document.getElementById("heroCanvas").animate([{ opacity: 0 }, { opacity: 1 }], { ...O, duration: 1400, delay: 1500, easing: "ease-out" });

        // corners: start together at the centre of the name block and spread out to frame it
        frame.classList.add("on");
        const fw = frame.offsetWidth, fh = frame.offsetHeight, leg = 28;
        const dx = fw / 2 - leg, dy = fh / 2 - leg;
        [["hf-tl", dx, dy], ["hf-tr", -dx, dy], ["hf-bl", dx, -dy], ["hf-br", -dx, -dy]].forEach(([c, x, y]) =>
          frame.querySelector("." + c).animate([{ transform: `translate(${x}px,${y}px)` }, { transform: "none" }],
            { ...O, duration: 1000, delay: 100, easing: "cubic-bezier(.7,0,.2,1)" }));
        frame.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 900, delay: 2750, easing: "ease", fill: "forwards" })
          .finished.then(() => frame.classList.remove("on")).catch(() => {});

        // letters rise from behind their line
        title.querySelectorAll(".ht-line").forEach((line, li) => {
          line.querySelectorAll(".ht-ch").forEach((ch, i) => ch.animate(
            [{ transform: "translateY(108%)" }, { transform: "none" }],
            { ...O, duration: 900, delay: (li ? 1000 : 850) + i * 28, easing: "cubic-bezier(.16,1,.3,1)" }));
        });
        fadeUp(document.querySelector(".hero-meta"), 1500);

        // buttons: pop in as a circle, overstretch sideways, spring back and settle
        document.querySelectorAll(".hero-links a").forEach((btn, i) => {
          const w = btn.offsetWidth, h = btn.offsetHeight, r = parseFloat(getComputedStyle(btn).borderTopLeftRadius) || 0;
          const d = 1500 + i * 100;
          btn.animate([
            { width: h + "px", height: h + "px", borderRadius: h / 2 + "px", transform: "scale(.3)", opacity: 0, easing: "cubic-bezier(.2,.8,.3,1)" },
            { width: h + "px", height: h + "px", borderRadius: h / 2 + "px", transform: "scale(1.08)", opacity: 1, offset: 0.22, easing: "ease-in-out" },
            { width: h + "px", height: h + "px", borderRadius: h / 2 + "px", transform: "scale(1)", offset: 0.32, easing: "cubic-bezier(.55,0,.25,1)" },
            { width: w * 1.12 + "px", height: h * 0.88 + "px", borderRadius: r + "px", offset: 0.58, easing: "ease-in-out" },
            { width: w * 0.965 + "px", height: h * 1.05 + "px", offset: 0.74, easing: "ease-in-out" },
            { width: w * 1.01 + "px", height: h + "px", offset: 0.88, easing: "ease-in-out" },
            { width: w + "px", height: h + "px", borderRadius: r + "px", transform: "none", opacity: 1 }
          ], { ...O, duration: 1150, delay: d });
          btn.querySelector(".btn-lbl").animate([{ opacity: 0, transform: "translateY(4px)" }, { opacity: 1, transform: "none" }],
            { ...O, duration: 450, delay: d + 630, easing: "ease-out" });
          if (btn.classList.contains("btn-solid")) // Résumé: starts as an outline, warms to orange once it settles
            btn.animate([
              { backgroundColor: "rgba(22,19,14,0)", color: "#efe7d7", boxShadow: "inset 0 0 0 1.5px " + LINE2 },
              { backgroundColor: ACCENT, color: "#16130e", boxShadow: "inset 0 0 0 1.5px " + ACCENT }
            ], { ...O, duration: 500, delay: d + 1000, easing: "ease" });
        });

        // menu button pops in last
        pillGroup.animate([
          { transform: "scale(.4)", opacity: 0, easing: "cubic-bezier(.2,.8,.3,1)" },
          { transform: "scale(1.08)", opacity: 1, offset: 0.6, easing: "ease-in-out" },
          { transform: "none", opacity: 1 }
