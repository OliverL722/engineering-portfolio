const courseIcon = (c) => COURSE_ICON[COURSE_GLYPH[c.code]] || COURSE_ICON[GROUP_GLYPH[c.grp]] || COURSE_ICON.book;
// little looping scene for each group's header (64×48)
const SKILL_ART = {
