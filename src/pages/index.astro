  }),
}));
const CAT = Object.fromEntries(CATS.map((c) => [c.key, c]));
const TOTAL = CATS.reduce((n, c) => n + c.projects.length, 0);
const featuredOf = (c) => c.projects.find((p) => p.featured) || c.projects[0];
const ALL_PROJECTS = CATS.flatMap((c) => c.projects.map((p) => ({ ...p, cat: c })));

/* ---------------- Skills (Education page) ----------------
   Four areas in a 2×2 grid. Clicking one flies it to the centre of the screen with its tools.
   Each tool lists where it was used:
     job(title, roleWord, text) → opens that job on Experience (uses its logo)
     proj(title, text)          → opens that project page (title must match a project above)
     crs(code, text)            → opens the course page */
const expAt = (title, role) => EXP.findIndex((e) => e.title === title && (!role || e.role.includes(role)));
const job = (title, role, what) => {
  const i = expAt(title, role);
  return { type: 'Job', where: title, what, logo: i >= 0 ? EXP[i].logo : undefined, href: '#experience', exp: i >= 0 ? i : undefined };
};
const proj = (title, what) => {
  const p = ALL_PROJECTS.find((x) => x.title === title);
  return { type: 'Project', where: title, what, href: p ? `#projects/${p.key}` : '#projects' };
};
const crs = (code, what) => ({ type: 'Course', where: code, what, href: COURSE_URL + code.replace(' ', '/'), ext: true });
