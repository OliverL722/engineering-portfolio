---
// Oliver Lesiakowski — Engineering Portfolio
// Single-file Astro page. Drop into src/pages/index.astro.
// Put Resume_Lesiakowski.pdf in /public so /Resume_Lesiakowski.pdf resolves.
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Oliver Lesiakowski | Engineering Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <!-- load-in intro: hide hero pieces before first paint (skipped for reduced motion; 4s failsafe) -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        d.classList.add("intro");
        setTimeout(function () { d.classList.remove("intro"); }, 4000);
      })();
    </script>
  </head>

  <body>
    <div class="grid-bg" aria-hidden="true"></div>

    <!-- ===================== NAV ===================== -->
    <nav class="top-nav">
            <div class="nav-center">
        <div class="pill-group is-collapsed" id="pillGroup">
          <button class="nav-burger" id="navBurger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="pillTabs">
            <span class="nav-burger-lines" aria-hidden="true"><i></i><i></i><i></i></span>
          </button>
          <div class="pill-tabs" id="pillTabs">
            <span class="pill-indicator" id="pillIndicator" aria-hidden="true"></span>
            <button class="navtab active" data-nav="home" type="button">HOME</button>
            <button class="navtab" data-nav="education" type="button">EDUCATION</button>
            <button class="navtab" data-nav="experience" type="button">EXPERIENCE</button>
            <button class="navtab" data-nav="projects" type="button">PROJECTS</button>
          </div>
        </div>
      </div>
    </nav>

    <main>
      <!-- ===================== HOME ===================== -->
      <section id="home" class="screen active">
        <header class="hero">
          <canvas id="heroCanvas" class="hero-canvas"></canvas>
          <div class="hero-inner">
            <div class="hero-frame" id="heroFrame" aria-hidden="true">
              <span class="hf-crn hf-tl"></span><span class="hf-crn hf-tr"></span><span class="hf-crn hf-bl"></span><span class="hf-crn hf-br"></span>
            </div>
            <h1 class="hero-title" id="heroTitle" aria-label="Oliver Lesiakowski">
              <span class="ht-line" aria-hidden="true">OLIVER</span>
              <span class="ht-line hero-title-sub" aria-hidden="true">LESIAKOWSKI</span>
            </h1>
            <div class="hero-meta mono">
              <span>Mechanical Engineering</span><span class="hero-dot"></span>
              <span>CS Minor</span><span class="hero-dot"></span>
              <span>UIUC '28</span>
            </div>
            <div class="hero-links">
              <a class="btn-solid mono" href="/Resume_Lesiakowski.pdf" target="_blank" rel="noopener noreferrer"><span class="btn-lbl">RÉSUMÉ ↗</span></a>
              <a class="btn-ghost mono" href="https://www.linkedin.com/in/olesiakowski" target="_blank" rel="noopener noreferrer"><span class="btn-lbl">LINKEDIN ↗</span></a>
              <a class="btn-ghost mono" href="mailto:ololesiakowski@gmail.com"><span class="btn-lbl">EMAIL</span></a>
            </div>
          </div>

          <div class="hero-scroll mono">↓</div>
        </header>

      </section>

      <!-- ===================== EDUCATION ===================== -->
      <section id="education" class="screen">
        <div class="page-wrap">
          <div class="rv section-head">
            <span class="mono section-num">01</span>
            <h2>EDUCATION</h2>
          </div>
          <div class="edu-3a bounce">
            <div class="rv">
              <h3 class="edu-school">University of Illinois Urbana-Champaign</h3>
              <p class="edu-college">Grainger College of Engineering</p>
              <div class="edu-strip">
                <span class="edu-strip-strong">B.S. Mechanical Engineering</span><span class="edu-sep">·</span>
                <span class="edu-strip-strong">CS Minor</span><span class="edu-sep">·</span>
                <span>GPA <span class="edu-gpa">3.84</span></span><span class="edu-sep">·</span>
                <span>Dean's List ×4</span><span class="edu-sep">·</span>
                <span>May 2028</span>
              </div>
            </div>
            <div class="rv edu-body">
              <div>
                <p class="edu-kicker">Relevant Coursework</p>
                <div class="edu-ledger">
                  <div class="edu-term">SP 2025</div>
                  <div class="edu-term-courses">
                    <a href="https://courses.illinois.edu/schedule/terms/ME/290" target="_blank" rel="noopener noreferrer" class="edu-chip"><span class="edu-chip-code">ME 290</span> CAD / Mechanical Design</a>
                  </div>
                  <div class="edu-term">FA 2025</div>
                  <div class="edu-term-courses">
                    <a href="https://courses.illinois.edu/schedule/terms/TAM/211" target="_blank" rel="noopener noreferrer" class="edu-chip"><span class="edu-chip-code">TAM 211</span> Dynamics</a>
                    <a href="https://courses.illinois.edu/schedule/terms/ME/270" target="_blank" rel="noopener noreferrer" class="edu-chip"><span class="edu-chip-code">ME 270</span> Design for Manufacturing</a>
                  </div>
                  <div class="edu-term">SP 2026</div>
                  <div class="edu-term-courses">
                    <a href="https://courses.illinois.edu/schedule/terms/CS/225" target="_blank" rel="noopener noreferrer" class="edu-chip"><span class="edu-chip-code">CS 225</span> Data Structures in C++</a>
                    <a href="https://courses.illinois.edu/schedule/terms/ME/200" target="_blank" rel="noopener noreferrer" class="edu-chip"><span class="edu-chip-code">ME 200</span> Thermodynamics</a>
                    <a href="https://courses.illinois.edu/schedule/terms/MATH/415" target="_blank" rel="noopener noreferrer" class="edu-chip"><span class="edu-chip-code">MATH 415</span> Linear Algebra</a>
                  </div>
                  <div class="edu-term edu-term-next">NEXT</div>
                  <div class="edu-term-courses"><span class="edu-next-line">Controls · Heat Transfer · Machine Design →</span></div>
                </div>
              </div>
              <div class="edu-rail">
                <div>
                  <p class="edu-kicker">On Campus</p>
                  <div class="edu-orgs">
                    <div class="edu-org"><span class="edu-org-name">ASME — Product Development</span><span class="edu-org-sub">Robotic 3D-print arm team</span></div>
                    <div class="edu-org"><span class="edu-org-name">Combustion Diagnostics Lab</span><span class="edu-org-sub">Undergrad research assistant</span></div>
                  </div>
                </div>
                <div>
                  <p class="edu-kicker">Toolchain</p>
                  <div class="edu-tools">
                    <span class="edu-tool">Fusion 360</span><span class="edu-tool">Creo</span><span class="edu-tool">C++</span><span class="edu-tool">Python</span><span class="edu-tool">Unity / C#</span><span class="edu-tool">3D Printing</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== EXPERIENCE ===================== -->
      <section id="experience" class="screen">
        <div class="page-wrap page-wrap-narrow">
          <div class="rv section-head">
            <span class="mono section-num">02</span>
            <h2>EXPERIENCE</h2>
          </div>
          <!-- LOGOS: swap the letter inside each <span class="exp-med"> for <img src="/logos/name.png" alt=""> -->
          <!-- PHOTOS: drop files into /public/photos/ matching the paths in EXP_DATA (script below); missing files fall back to a styled placeholder. -->
          <div id="expSplit" class="exp-split">
            <div id="expTimeline" class="exp-rail-col bounce">
              <div class="exp-spine">
                <span class="exp-spine-cap exp-cap-top"></span>
                <div id="expSpineFill" class="exp-spine-fill"></div>
                <span class="exp-spine-slits"></span>
                <span class="exp-spine-cap exp-cap-bot"></span>
              </div>

              <div class="rv exp-entry" data-exp-entry="0">
                <div class="exp-med-col">
                  <span class="exp-med">M</span>
                  <span class="exp-stub"></span>
                </div>
                <button class="exp-bubble" data-exp-open="0" type="button">
                  <span class="exp-bubble-head">
                    <h3 class="exp-company">Motorola Solutions</h3>
                    <span class="exp-current-badge">CURRENT</span>
                    <span class="exp-open-hint mono">OPEN &rarr;</span>
                  </span>
                  <p class="exp-role">Battery Cell Engineering Intern</p>
                  <p class="exp-meta">MAY 2026 &ndash; PRESENT &middot; CHICAGO, IL</p>
                  <p class="exp-summary">Lithium-ion cell safety and characterization testing for mission-critical communications hardware.</p>
                </button>
              </div>

              <div class="rv exp-entry" data-exp-entry="1">
                <div class="exp-med-col">
                  <span class="exp-med">U</span>
                  <span class="exp-stub"></span>
                </div>
                <button class="exp-bubble" data-exp-open="1" type="button">
                  <span class="exp-bubble-head">
                    <h3 class="exp-company">UIUC Combustion Diagnostics Lab</h3>
                    <span class="exp-open-hint mono">OPEN &rarr;</span>
                  </span>
                  <p class="exp-role">ME Research Assistant</p>
                  <p class="exp-meta">JAN 2026 &ndash; MAY 2026 &middot; URBANA, IL</p>
                  <p class="exp-summary">Fixture design and fabrication supporting combustion diagnostics research at the University of Illinois.</p>
                </button>
              </div>

              <div class="rv exp-entry" data-exp-entry="2">
                <div class="exp-med-col">
                  <span class="exp-med">T</span>
                  <span class="exp-stub"></span>
                </div>
                <button class="exp-bubble" data-exp-open="2" type="button">
                  <span class="exp-bubble-head">
                    <h3 class="exp-company">Tiptek, LLC</h3>
                    <span class="exp-open-hint mono">OPEN &rarr;</span>
                  </span>
                  <p class="exp-role">Laboratory Technician</p>
                  <p class="exp-meta">OCT 2025 &ndash; JAN 2026 &middot; CHAMPAIGN, IL</p>
                  <p class="exp-summary">Precision manufacturing of tungsten nanoprobes for semiconductor failure analysis.</p>
                </button>
              </div>

              <div class="rv exp-entry" data-exp-entry="3">
                <div class="exp-med-col">
                  <span class="exp-med">TV</span>
                  <span class="exp-stub"></span>
                </div>
                <button class="exp-bubble" data-exp-open="3" type="button">
                  <span class="exp-bubble-head">
                    <h3 class="exp-company">True Value / Do it Best</h3>
                    <span class="exp-open-hint mono">OPEN &rarr;</span>
                  </span>
                  <p class="exp-role">Senior Sales &amp; Technical Associate</p>
                  <p class="exp-meta">JUL 2023 &ndash; AUG 2025 &middot; PALATINE, IL</p>
                  <p class="exp-summary">Technical service lead handling training, inventory, and hands-on hardware solutions for 50&ndash;70 customers per shift.</p>
                </button>
              </div>
            </div>

            <aside id="expDetail" class="exp-detail" aria-hidden="true">
              <button id="expDetailClose" class="exp-detail-close mono" type="button">CLOSE&nbsp;&rarr;</button>
