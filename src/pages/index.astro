        fadeUp(document.querySelector(".hero-scroll"), 2600);

        root.classList.remove("intro"); // animations now own the hidden state
      }

      /* ---------- boot ---------- */
      const startHash = (window.location.hash || "").replace("#", "");
      const start = ["home", "education", "experience", "projects"].includes(startHash) ? startHash : "home";
