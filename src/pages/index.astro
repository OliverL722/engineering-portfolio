      .hf-tr { right: 0; top: 0; border-top-width: 1.5px; border-right-width: 1.5px; }
      .hf-bl { left: 0; bottom: 0; border-bottom-width: 1.5px; border-left-width: 1.5px; }
      .hf-br { right: 0; bottom: 0; border-bottom-width: 1.5px; border-right-width: 1.5px; }
      .ht-line { display: block; overflow: hidden; padding: .05em 0 .06em; margin: -.05em 0 -.06em; }
      .ht-ch { display: inline-block; }
      .hero-kicker { margin: 0 0 1.5rem; font-size: 13px; letter-spacing: .3em; text-transform: uppercase; color: var(--accent); }
      .hero-cursor { animation: blink 1.1s steps(1) infinite; }
      .hero-title { margin: 0 0 1.7rem; font-size: clamp(3rem, 10vw, 9rem); line-height: .86; font-weight: 800; letter-spacing: -.03em; color: var(--ink); }
      .hero-title-sub { color: var(--faint); }
      .hero-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 1.1rem; font-size: .95rem; color: var(--muted); }
      .hero-meta > span:not(.hero-dot) { color: var(--ink); }
      .hero-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); display: inline-block; }
      .hero-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 38px; pointer-events: auto; }
      .hero-links a { justify-content: center; white-space: nowrap; }
      .btn-lbl { display: inline-block; flex: none; }
      /* before the load-in script takes over (removed by JS, 4s failsafe in <head>) */
      html.intro .grid-bg, html.intro .hero-canvas, html.intro .hero-title, html.intro .hero-meta,
      html.intro .hero-links a, html.intro .hero-scroll, html.intro .pill-group { opacity: 0; }
      .hero-scroll { position: absolute; bottom: 34px; left: 7vw; font-size: 1.3rem; color: var(--faint); z-index: 2; animation: drift 2.6s ease-in-out infinite; }
      .title-block { position: absolute; bottom: 34px; right: 7vw; z-index: 2; border: 1px solid var(--line2); background: rgba(22,19,14,.7); font-size: 10px; line-height: 1; display: grid; grid-template-columns: auto auto; }
      .title-block > div { padding: 8px 12px; }
      .tb-key { border-right: 1px solid var(--line); color: var(--faint); }
      .tb-key:first-child, .title-block .tb-val:nth-child(2) { border-bottom: 1px solid var(--line); }

      .btn-solid { position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: 9px; background: var(--accent); color: #16130e; padding: 13px 22px; font-size: 12px; letter-spacing: .06em; font-weight: 700; }
      .btn-solid:hover { opacity: .9; }
      .btn-ghost { position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: 9px; border: 1.5px solid var(--line2); padding: 13px 22px; font-size: 12px; letter-spacing: .06em; color: var(--ink); transition: border-color .15s, color .15s; }
      .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
      .btn-solid::after, .btn-ghost::after { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 45%; transform: translateX(-140%) skewX(-18deg); pointer-events: none; }
      .btn-solid::after { background: linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent); }
      .btn-ghost::after { background: linear-gradient(90deg, transparent, rgba(239,231,215,.12), transparent); }
      .btn-solid:hover::after, .btn-ghost:hover::after { animation: shineSweep .7s ease .05s; }
      @keyframes shineSweep { from { transform: translateX(-140%) skewX(-18deg); } to { transform: translateX(240%) skewX(-18deg); } }

      /* INDEX CARDS */
      .index-section { position: relative; z-index: 1; padding: 20px 7vw 110px; }
      .index-label { font-size: 12px; letter-spacing: .16em; color: var(--faint); border-bottom: 1.5px solid var(--line2); padding-bottom: 12px; margin-bottom: 30px; }
      .index-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
      .index-card { text-align: left; cursor: pointer; background: var(--panel); border: 1px solid var(--line); padding: 26px; display: flex; flex-direction: column; gap: 12px; font-family: "Archivo", sans-serif; border-radius: 6px; transition: transform .3s cubic-bezier(.2,.7,.2,1), border-color .3s, box-shadow .3s; }
      .index-card:hover { transform: translateY(-6px); border-color: rgba(var(--accent-rgb), .5); box-shadow: 0 16px 40px rgba(0,0,0,.35); }
      .index-card-top { display: flex; justify-content: space-between; align-items: center; }
      .index-num { font-size: 30px; font-weight: 700; color: var(--accent); }
      .index-sheet { font-size: 11px; color: var(--faint); }
      .index-card-title { font-weight: 800; font-size: 24px; letter-spacing: -.01em; color: var(--ink); }
      .index-card-desc { font-size: 12px; color: var(--muted); line-height: 1.6; }

      /* EDUCATION — spec strip + semester ledger + rail */
      .edu-school { margin: 0 0 6px; font-size: clamp(20px, 2.4vw, 26px); font-weight: 700; letter-spacing: -.01em; line-height: 1.12; color: var(--ink); }
      .edu-college { margin: 0 0 14px; font-family: "Space Mono", monospace; font-size: 12px; color: var(--faint); }
      .edu-strip { font-family: "Space Mono", monospace; font-size: 13.5px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 8px 0; align-items: center; line-height: 1.6; }
      .edu-strip-strong { color: var(--ink); }
      .edu-sep { color: var(--accent); padding: 0 12px; }
      .edu-gpa { color: var(--accent); font-weight: 700; }
      .edu-kicker { margin: 0 0 6px; font-family: "Space Mono", monospace; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--faint); }
      .edu-body { display: grid; grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: start; margin-top: 40px; }
      .edu-ledger { display: grid; grid-template-columns: 110px 1fr; }
      .edu-term { font-family: "Space Mono", monospace; font-size: 12px; color: var(--accent); padding: 16px 0; border-top: 1px solid var(--line); }
      .edu-term-next { color: var(--faint); }
      .edu-term-courses { padding: 16px 0; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-start; }
      .edu-chip { font-family: "Space Mono", monospace; font-size: 12px; color: var(--ink); border: 1px solid rgba(233,214,180,.14); border-radius: 3px; padding: 7px 12px; text-decoration: none; transition: border-color .16s, background .16s, transform .16s; }
      .edu-chip:hover { border-color: rgba(var(--accent-rgb), .5); background: rgba(var(--accent-rgb), .06); transform: translateY(-2px); }
      .edu-chip-code { color: var(--accent); }
      .edu-next-line { font-family: "Space Mono", monospace; font-size: 13px; color: var(--faint); padding-top: 7px; }
      .edu-rail { display: flex; flex-direction: column; gap: 28px; }
      .edu-rail .edu-kicker { margin-bottom: 14px; }
      .edu-orgs { display: flex; flex-direction: column; gap: 12px; }
      .edu-org { border-left: 2px solid rgba(var(--accent-rgb), .5); padding-left: 14px; }
      .edu-org-name { display: block; font-size: 14px; font-weight: 600; color: var(--ink); }
      .edu-org-sub { font-family: "Space Mono", monospace; font-size: 11.5px; color: var(--muted); }
      .edu-tools { display: flex; flex-wrap: wrap; gap: 7px; }
      .edu-tool { font-family: "Space Mono", monospace; font-size: 11px; color: var(--muted); border: 1px solid rgba(233,214,180,.14); border-radius: 100px; padding: 5px 11px; }

      /* EXPERIENCE — magnetic bubble timeline + split detail */
      .exp-split { position: relative; }
      .exp-rail-col { position: relative; transition: transform .6s cubic-bezier(.32,1.1,.36,1), opacity .45s ease; }
      .exp-split.detail-open .exp-rail-col { transform: translateX(-6%); opacity: .4; }
      .exp-spine { position: absolute; left: 26px; top: 22px; bottom: 26px; width: 2px; border-radius: 2px; background: linear-gradient(to bottom, rgba(233,214,180,.16), rgba(233,214,180,.05)); }
      .exp-spine-fill { position: absolute; top: 0; left: -1px; width: 4px; height: 0%; border-radius: 4px; background: linear-gradient(to bottom, var(--accent), rgba(var(--accent-rgb), .35)); box-shadow: 0 0 12px rgba(var(--accent-rgb), .4); transition: height .12s linear; }
      .exp-spine-slits { display: none; }
      .exp-spine-cap { position: absolute; left: 50%; width: 8px; height: 8px; }
      .exp-cap-top { top: -8px; transform: translateX(-50%) rotate(45deg); background: var(--accent); box-shadow: 0 0 10px rgba(var(--accent-rgb), .6); }
      .exp-cap-bot { bottom: -8px; transform: translateX(-50%) rotate(45deg); border: 1.5px solid rgba(var(--accent-rgb), .4); background: var(--bg); }
      .exp-entry { --f: 0; position: relative; display: grid; grid-template-columns: 72px 1fr; gap: 0 16px; padding-bottom: 54px; }
      .exp-entry:last-child { padding-bottom: 0; }
      .exp-med-col { position: relative; }
      .exp-med { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 50%; overflow: hidden; background: repeating-linear-gradient(45deg, #1b1812, #1b1812 6px, #201c16 6px, #201c16 12px); border: 2px solid rgba(var(--accent-rgb), calc(.22 + .68 * var(--f))); font-family: "Space Mono", monospace; font-size: 17px; font-weight: 700; color: var(--ink); filter: grayscale(calc(1 - var(--f))); opacity: calc(.4 + .6 * var(--f)); transform: scale(calc(.72 + .5 * var(--f))); box-shadow: 0 0 calc(26px * var(--f)) rgba(var(--accent-rgb), calc(.5 * var(--f))), 0 0 0 calc(6px * var(--f)) rgba(var(--accent-rgb), .07); }
      .exp-med img { width: 100%; height: 100%; object-fit: contain; }
      .exp-stub { position: absolute; left: 56px; top: 27px; width: 34px; height: 2px; background: linear-gradient(90deg, rgba(var(--accent-rgb), .6), rgba(var(--accent-rgb), .12)); }
      .exp-bubble { display: block; width: 100%; text-align: left; font-family: inherit; color: var(--ink); background: #1b1812; border: 1px solid rgba(var(--accent-rgb), calc(.16 + .42 * var(--f))); border-radius: 14px; padding: 20px 24px; cursor: pointer; opacity: calc(.6 + .4 * var(--f)); transform: scale(calc(.982 + .018 * var(--f))); transform-origin: left center; box-shadow: 0 6px 22px rgba(0,0,0,.28), 0 0 calc(20px * var(--f)) rgba(var(--accent-rgb), calc(.14 * var(--f))); transition: border-color .2s ease; }
      .exp-bubble:hover { border-color: rgba(var(--accent-rgb), .7); }
      .exp-bubble-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .exp-company { font-size: clamp(20px, 2.4vw, 25px); font-weight: 800; letter-spacing: -.02em; line-height: 1.05; color: var(--ink); margin: 0; }
      .exp-open-hint { margin-left: auto; font-size: 11px; letter-spacing: .12em; color: var(--accent); }
      .exp-current-badge { font-family: "Space Mono", monospace; font-size: .62rem; letter-spacing: .16em; color: var(--green); border: 1px solid rgba(61,220,132,.5); padding: .22rem .6rem; white-space: nowrap; animation: badgePulse 2.2s ease-in-out infinite; }
      .exp-role { font-family: "Space Mono", monospace; font-size: .8rem; color: var(--accent); margin: .55rem 0 .15rem; }
      .exp-meta { font-family: "Space Mono", monospace; font-size: .7rem; color: var(--faint); margin: 0 0 .7rem; letter-spacing: .03em; }
      .exp-summary { font-size: .9rem; line-height: 1.65; color: var(--muted); margin: 0; }
      .exp-detail { position: fixed; top: 0; right: 0; bottom: 0; z-index: 9500; width: min(560px, 94vw); background: var(--panel2); border-left: 2px solid rgba(var(--accent-rgb), .5); box-shadow: -24px 0 48px rgba(0,0,0,.5); padding: 96px 36px 40px; overflow-y: auto; transform: translateX(106%); transition: transform .6s cubic-bezier(.32,1.1,.36,1); }
      .exp-detail.open { transform: translateX(0); }
      .exp-detail-close { color: var(--accent); border: 1px solid rgba(var(--accent-rgb), .35); background: rgba(var(--accent-rgb), .06); border-radius: 100px; padding: .55rem 1rem; font-size: .72rem; letter-spacing: .12em; cursor: pointer; transition: transform .16s, border-color .16s; }
      .exp-detail-close:hover { transform: translateX(4px); border-color: var(--accent); }
      .exp-detail-kicker { margin: 20px 0 6px; font-size: 11px; letter-spacing: .22em; color: var(--accent); }
      .exp-detail-titlerow { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .exp-detail-titlerow h3 { font-size: 29px; font-weight: 800; letter-spacing: -.025em; line-height: 1.05; color: var(--ink); }
      .exp-detail-summary { font-size: 14px; line-height: 1.7; color: var(--muted); margin: 0 0 18px; }
      .exp-detail-bullets { border-top: 1px dashed rgba(233,214,180,.22); padding-top: 16px; display: flex; flex-direction: column; gap: 11px; margin-bottom: 22px; }
      .exp-detail-bullet { display: flex; gap: 12px; align-items: flex-start; font-size: 13px; line-height: 1.6; color: var(--muted); }
      .exp-tick { width: 11px; height: 9px; background: var(--accent); transform: skewX(-18deg); flex-shrink: 0; margin-top: 6px; }
      .exp-detail-label { font-size: 11px; letter-spacing: .22em; color: var(--faint); margin: 0 0 10px; }
      .exp-detail-photos { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
      .exp-photo { position: relative; height: 150px; border-radius: 10px; overflow: hidden; border: 1px dashed rgba(var(--accent-rgb), .35); background: repeating-linear-gradient(45deg, var(--panel2), var(--panel2) 9px, var(--panel) 9px, var(--panel) 18px); display: grid; place-items: center; }
      .exp-photo > span { font-size: .72rem; color: var(--accent); text-align: center; padding: 0 10px; }
      .exp-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

      /* PROJECTS */
      .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
      .project-category-card { position: relative; cursor: pointer; overflow: hidden; min-height: 200px; padding: 26px; border: 1px solid var(--line); background: var(--panel); border-radius: 6px; transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
      .project-category-card:hover { transform: translateY(-5px); border-color: rgba(var(--accent-rgb), .5); box-shadow: 0 16px 40px rgba(0,0,0,.35); }
      .crn { position: absolute; width: 14px; height: 14px; opacity: .35; pointer-events: none; z-index: 4; transition: top .28s cubic-bezier(.22,1,.36,1), bottom .28s cubic-bezier(.22,1,.36,1), left .28s cubic-bezier(.22,1,.36,1), right .28s cubic-bezier(.22,1,.36,1), opacity .28s, border-color .28s; }
      .crn-tl { top: 11px; left: 11px; border-top: 1.5px solid rgba(233,214,180,.3); border-left: 1.5px solid rgba(233,214,180,.3); }
      .crn-tr { top: 11px; right: 11px; border-top: 1.5px solid rgba(233,214,180,.3); border-right: 1.5px solid rgba(233,214,180,.3); }
      .crn-bl { bottom: 11px; left: 11px; border-bottom: 1.5px solid rgba(233,214,180,.3); border-left: 1.5px solid rgba(233,214,180,.3); }
      .crn-br { bottom: 11px; right: 11px; border-bottom: 1.5px solid rgba(233,214,180,.3); border-right: 1.5px solid rgba(233,214,180,.3); }
      .project-category-card:hover .crn, .project-category-card:focus-visible .crn { opacity: 1; border-color: var(--accent); }
      .project-category-card:hover .crn-tl, .project-category-card:focus-visible .crn-tl { top: 5px; left: 5px; }
      .project-category-card:hover .crn-tr, .project-category-card:focus-visible .crn-tr { top: 5px; right: 5px; }
      .project-category-card:hover .crn-bl, .project-category-card:focus-visible .crn-bl { bottom: 5px; left: 5px; }
      .project-category-card:hover .crn-br, .project-category-card:focus-visible .crn-br { bottom: 5px; right: 5px; }
      .project-number { font-family: "Space Mono", monospace; color: var(--accent); margin: 0 0 1.4rem; position: relative; z-index: 3; }
      .card-title { color: var(--ink); font-size: 1.5rem; font-weight: 700; margin: 0 0 .7rem; letter-spacing: -.01em; position: relative; z-index: 3; max-width: 64%; }
      .project-type { font-family: "Space Mono", monospace; color: var(--muted); font-size: .86rem; line-height: 1.6; margin: 0; position: relative; z-index: 3; max-width: 62%; }
      body.hover-lock .project-category-card, body.hover-lock .project-row { pointer-events: none; }

      /* category card graphics */
      .carv { position: absolute; right: 8px; bottom: 16px; width: 160px; height: 118px; z-index: 1; }
      .carv .wheel { transform-box: fill-box; transform-origin: center; animation: pcRoll 2.6s linear infinite; }
      @keyframes pcRoll { to { transform: rotate(360deg); } }
      @keyframes spin { to { transform: rotate(360deg); } }
      @keyframes spinr { to { transform: rotate(-360deg); } }
      .wfc { position: absolute; right: 8px; bottom: 12px; width: 146px; height: 146px; z-index: 1; opacity: .92; }
      .gearsx { position: absolute; right: 10px; bottom: 14px; width: 140px; height: 140px; z-index: 1; }
      .mon { position: absolute; right: 12px; bottom: 16px; width: 150px; z-index: 1; opacity: .97; transform: scale(.8); transform-origin: bottom right; }
      .mon-screen { border: 1.6px solid var(--accent); border-radius: 5px; background: #120f0b; overflow: hidden; }
      .mon-bar { height: 14px; background: var(--panel2); border-bottom: 1px solid rgba(var(--accent-rgb), .3); display: flex; align-items: center; gap: 4px; padding: 0 7px; }
      .mon-bar i { width: 5px; height: 5px; border-radius: 50%; background: rgba(var(--accent-rgb), .5); display: block; }
      .mon-body { height: 74px; overflow: hidden; position: relative; padding: 8px 9px; }
      .code-scroll { will-change: transform; }
      .cl { display: flex; gap: 4px; align-items: center; height: 6px; margin-bottom: 7px; }
      .cl .bar { height: 5px; border-radius: 2px; }
      .cl .bar.a { background: var(--accent); }
      .cl .bar.m { background: rgba(233,214,180,.3); }
      .cl .ind { width: 9px; flex: none; }
      @keyframes pcCodeScroll { from { transform: translateY(0); } to { transform: translateY(-50%); } }
      /* software: inspect mode on hover (scanline + glow fade in/out smoothly) */
      .mon-screen { position: relative; transition: box-shadow .4s ease; }
      .mon-screen::after { content: ""; position: absolute; left: 0; right: 0; top: -22%; height: 16px; background: linear-gradient(180deg, transparent, rgba(var(--accent-rgb), .25), transparent); opacity: 0; transition: opacity .4s ease; animation: scanSweep 2.8s linear infinite; pointer-events: none; }
      .project-category-card[data-project="software"]:hover .mon-screen { box-shadow: 0 0 16px rgba(var(--accent-rgb), .3); }
      .project-category-card[data-project="software"]:hover .mon-screen::after { opacity: 1; }
      @keyframes scanSweep { from { top: -22%; } to { top: 108%; } }
      .mon-neck { width: 16px; height: 9px; margin: 0 auto; background: var(--panel2); border: 1.6px solid var(--accent); border-top: none; }
      .mon-base { width: 48px; height: 5px; margin: 0 auto; background: var(--panel2); border: 1.6px solid var(--accent); border-radius: 0 0 3px 3px; }

      #card-expand-hero { position: fixed; pointer-events: none; z-index: 10000; background: var(--panel); border: 1px solid rgba(var(--accent-rgb), .5); box-shadow: 0 0 80px rgba(var(--accent-rgb), .14); will-change: left, top, width, height; transition: left .2s cubic-bezier(.4,0,.2,1), top .2s cubic-bezier(.4,0,.2,1), width .2s cubic-bezier(.4,0,.2,1), height .2s cubic-bezier(.4,0,.2,1), border-radius .2s cubic-bezier(.4,0,.2,1), opacity .35s ease; }
      #card-expand-hero.hero-fade-out { opacity: 0; }
      .detail-page { opacity: 0; transition: opacity .18s ease; }
      .detail-page.active { opacity: 1; }
      .detail-page-header { max-width: 920px; margin: 0 auto 2.6rem; text-align: center; }
      .detail-page-header h2 { font-size: clamp(2.6rem, 6.5vw, 5.2rem); line-height: .95; margin: .4rem 0 1rem; white-space: nowrap; font-weight: 700; letter-spacing: -.02em; color: var(--ink); }
      .section-label { color: var(--accent); letter-spacing: .2em; font-size: .78rem; text-transform: uppercase; margin: 0; }
      .detail-time { font-family: "Space Mono", monospace; color: var(--accent); margin: 0 0 1rem; }
      .detail-description { color: var(--muted); line-height: 1.8; font-size: 1.02rem; margin: 0 auto; max-width: 62ch; }
      .back-button { margin-bottom: 2rem; color: var(--accent); border: 1px solid rgba(var(--accent-rgb), .35); background: rgba(var(--accent-rgb), .06); padding: .8rem 1rem; border-radius: 100px; font-size: .82rem; cursor: pointer; transition: transform .16s, border-color .16s, background .16s; }
      .back-button:hover { transform: translateX(-4px); border-color: var(--accent); background: rgba(var(--accent-rgb), .12); }
      .project-row-list { display: grid; gap: 1rem; max-width: 1000px; margin: 0 auto; }
      .project-row { width: 100%; font-family: inherit; border: 1px solid var(--line); background: linear-gradient(135deg, rgba(var(--accent-rgb), .035), transparent 35%), var(--panel); color: var(--ink); border-radius: 10px; padding: 1.3rem 1.5rem; display: grid; grid-template-columns: 1.3fr 1fr auto; align-items: center; gap: 1.2rem; cursor: pointer; text-align: left; opacity: 0; transform: translateY(10px); animation: rowIn .3s ease forwards; transition: transform .16s, border-color .16s, background .16s, box-shadow .16s; }
      .project-row:nth-child(1) { animation-delay: .03s; } .project-row:nth-child(2) { animation-delay: .07s; } .project-row:nth-child(3) { animation-delay: .11s; }
      .project-row:hover { transform: translateY(-4px); border-color: rgba(var(--accent-rgb), .55); box-shadow: 0 14px 34px rgba(0,0,0,.32); }
      .project-row-main { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center; }
      .project-row-main .project-number { margin: 0; min-width: 2.4rem; }
      .project-row-text h3 { margin: 0 0 .35rem; color: var(--ink); font-size: 1.3rem; font-weight: 700; }
      .project-row-text p { margin: 0; color: var(--muted); font-family: "Space Mono", monospace; font-size: .84rem; }
