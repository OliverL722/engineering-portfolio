              <div class="exp-detail-titlerow">
                <h3 id="expDetailTitle">Company</h3>
                <span id="expDetailBadge" class="exp-current-badge" hidden>CURRENT</span>
              </div>
              <p id="expDetailRole" class="exp-role"></p>
              <p id="expDetailMeta" class="exp-meta"></p>
              <p id="expDetailSummary" class="exp-detail-summary"></p>
              <div id="expDetailBullets" class="exp-detail-bullets"></div>
              <p class="mono exp-detail-label">PHOTOS</p>
              <div id="expDetailPhotos" class="exp-detail-photos"></div>
            </aside>
          </div>
        </div>
      </section>

      <!-- ===================== PROJECTS ===================== -->
      <section id="projects" class="screen">
        <div class="page-wrap" id="projectsRoot">
          <div id="projectsOverview">
            <div class="rv section-head">
              <span class="mono section-num">03</span>
              <h2>PROJECTS</h2>
            </div>
            <div class="rv project-grid">
              <article class="project-category-card" data-project="completed" tabindex="0">
                <span class="crn crn-tl" aria-hidden="true"></span><span class="crn crn-tr" aria-hidden="true"></span><span class="crn crn-bl" aria-hidden="true"></span><span class="crn crn-br" aria-hidden="true"></span>
                <svg class="carv" viewBox="0 0 160 118" aria-hidden="true">
                  <g id="carRig">
                    <path d="M20 91 L20 78 Q20 72 28 70 L42 67 L54 51 Q57 47 63 47 L97 47 Q103 47 107 51 L120 67 L134 70 Q140 72 140 78 L140 91 Z" fill="rgba(221,91,60,.08)" stroke="#dd5b3c" stroke-width="1.6" stroke-linejoin="round"></path>
                    <path d="M59 52 L77 52 L77 65 L51 65 Z" fill="rgba(221,91,60,.15)" stroke="#dd5b3c" stroke-width="1.3" stroke-linejoin="round"></path>
                    <path d="M83 52 L103 52 L111 65 L83 65 Z" fill="rgba(221,91,60,.15)" stroke="#dd5b3c" stroke-width="1.3" stroke-linejoin="round"></path>
                    <line x1="80" y1="50" x2="80" y2="88" stroke="rgba(221,91,60,.45)" stroke-width="1.2"></line>
                    <line x1="84" y1="71" x2="91" y2="71" stroke="#dd5b3c" stroke-width="1.6" stroke-linecap="round"></line>
                    <rect x="133" y="73" width="6" height="5" rx="1.5" fill="#dd5b3c"></rect>
                    <rect x="21" y="73" width="5" height="5" rx="1.5" fill="rgba(221,91,60,.5)"></rect>
                    <g id="carW1" transform="translate(48,93)"><g><circle r="13" fill="#1b1812" stroke="#dd5b3c" stroke-width="1.6"></circle><circle r="3.4" fill="#dd5b3c"></circle><path d="M0 -11 L0 11 M-11 0 L11 0" stroke="rgba(221,91,60,.6)" stroke-width="1.2"></path></g></g>
                    <g id="carW2" transform="translate(112,93)"><g><circle r="13" fill="#1b1812" stroke="#dd5b3c" stroke-width="1.6"></circle><circle r="3.4" fill="#dd5b3c"></circle><path d="M0 -11 L0 11 M-11 0 L11 0" stroke="rgba(221,91,60,.6)" stroke-width="1.2"></path></g></g>
                  </g>
                </svg>
                <p class="project-number">01</p><h3 class="card-title">Completed Projects</h3><p class="project-type">Finished builds with a clear final result, physical prototype, or tested outcome.</p>
              </article>
              <article class="project-category-card" data-project="models" tabindex="0">
                <span class="crn crn-tl" aria-hidden="true"></span><span class="crn crn-tr" aria-hidden="true"></span><span class="crn crn-bl" aria-hidden="true"></span><span class="crn crn-br" aria-hidden="true"></span>
                <canvas class="wfc" data-shape="cube" aria-hidden="true"></canvas>
                <p class="project-number">02</p><h3 class="card-title">3D Models</h3><p class="project-type">CAD models, assemblies, mechanisms, design studies, and class-based modeling work.</p>
              </article>
              <article class="project-category-card" data-project="current" tabindex="0">
                <span class="crn crn-tl" aria-hidden="true"></span><span class="crn crn-tr" aria-hidden="true"></span><span class="crn crn-bl" aria-hidden="true"></span><span class="crn crn-br" aria-hidden="true"></span>
                <svg class="gearsx" id="projGears" viewBox="0 0 150 150" aria-hidden="true"></svg>
                <p class="project-number">03</p><h3 class="card-title">Current Projects</h3><p class="project-type">Active work, ongoing prototypes, research-related builds, and projects still being improved.</p>
              </article>
              <article class="project-category-card" data-project="software" tabindex="0">
                <span class="crn crn-tl" aria-hidden="true"></span><span class="crn crn-tr" aria-hidden="true"></span><span class="crn crn-bl" aria-hidden="true"></span><span class="crn crn-br" aria-hidden="true"></span>
                <div class="mon" aria-hidden="true">
                  <div class="mon-screen">
                    <div class="mon-bar"><i></i><i></i><i></i></div>
                    <div class="mon-body"><div class="code-scroll" id="codeScroll"></div></div>
                  </div>
                  <div class="mon-neck"></div>
                  <div class="mon-base"></div>
                </div>
                <p class="project-number">04</p><h3 class="card-title">Software Projects</h3><p class="project-type">Programming work, web development, school coding projects, tools, and technical scripts.</p>
              </article>
            </div>
          </div>

          <div id="projectCategoryPage" class="detail-page" hidden>
            <button id="categoryBackButton" class="back-button mono" type="button">← Back to project categories</button>
            <div class="detail-page-header pop-in">
              <p id="categoryKicker" class="mono section-label">Project Category</p>
              <h2 id="categoryTitle">Category Title</h2>
              <p id="categoryDescription" class="detail-description">Description.</p>
            </div>
            <div id="categoryProjectRows" class="project-row-list"></div>
          </div>

          <div id="individualProjectPage" class="detail-page" hidden>
            <button id="individualBackButton" class="back-button mono" type="button">← Back to category</button>
            <div class="detail-page-header pop-in">
              <p id="individualKicker" class="mono section-label">Project</p>
              <h2 id="individualTitle">Project Title</h2>
              <p id="individualTime" class="detail-time">Time</p>
              <p id="individualDescription" class="detail-description">Description.</p>
            </div>
            <div class="project-work-hero pop-in">
              <section class="detail-panel project-summary-card">
                <div class="detail-panel-header"><p class="project-number">Highlights</p><h3>Project summary</h3></div>
                <ul id="individualBullets" class="detail-bullet-list"></ul>
              </section>
              <div class="detail-media large-media"><span id="individualMainImage">Main image placeholder</span></div>
            </div>
            <div class="detail-layout pop-in">
              <section class="detail-panel">
                <div class="detail-panel-header"><p class="project-number">Gallery</p><h3>Image placeholders</h3></div>
                <div class="placeholder-grid"><div class="mini-photo-placeholder"><span>Image 01</span></div><div class="mini-photo-placeholder"><span>Image 02</span></div><div class="mini-photo-placeholder"><span>Image 03</span></div><div class="mini-photo-placeholder"><span>Image 04</span></div></div>
