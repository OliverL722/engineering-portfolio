// derived — no need to edit below
const CATS = PROJECT_CATS.map((c) => ({
  ...c,
  projects: c.projects.map((p, i, arr) => {
    const next = arr[(i + 1) % arr.length];
    return { ...p, sections: p.sections || [], gallery: p.gallery || [], key: `${c.key}-${i}`, nextKey: `${c.key}-${(i + 1) % arr.length}`, nextTitle: next.title };
  }),
}));
const CAT = Object.fromEntries(CATS.map((c) => [c.key, c]));
const TOTAL = CATS.reduce((n, c) => n + c.projects.length, 0);
const featuredOf = (c) => c.projects.find((p) => p.featured) || c.projects[0];
const ALL_PROJECTS = CATS.flatMap((c) => c.projects.map((p) => ({ ...p, cat: c })));

