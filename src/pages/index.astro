              </div>
              {p.gallery.length > 0 && (
                <section class="pd-gal fx-rise" style="--d:.22s" aria-labelledby={`gal-${p.key}`}>
                  <div class="block-head">
                    <h3 class="h3" id={`gal-${p.key}`}>Gallery</h3>
                    <span class="count mono">{p.gallery.length} {p.gallery.length === 1 ? 'photo' : 'photos'}</span>
                  </div>
                  <div class="gal">
                    {p.gallery.map((g) => (
                      <button class:list={['gal-item', { cad: g.cad }]} type="button" data-zoom={g.src} data-cap={g.caption} aria-label={`View photo: ${g.caption}`}>
                        <img src={sm(g.src)} data-full={g.src} alt={g.caption} loading="lazy" decoding="async" onerror={FALLBACK} />
                        <span class="gal-cap" aria-hidden="true">{g.caption}</span>
                      </button>
                    ))}
                  </div>
                </section>
              )}
              <div class="pd-foot">
                <button class="btn btn-ghost btn-sm" type="button" data-back>‹ All projects</button>
                {p.nextKey !== p.key && (
                  <button class="btn btn-primary btn-sm" type="button" data-open={p.nextKey}>Next: {p.nextTitle} <span aria-hidden="true">›</span></button>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <!-- ===================== FOOTER ===================== -->
    <footer class="foot" id="siteFooter">
      <div class="foot-in">
        <nav class="socials" aria-label="Contact and social links">
          {SOCIALS.filter((x) => x.href).map((x) => (
            <a class={`soc soc-${x.id}`} href={x.href} aria-label={x.label} data-tip={x.tip} {...(x.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" set:html={x.icon}></svg>
            </a>
          ))}
        </nav>
        <p class="foot-meta mono">© {new Date().getFullYear()} Oliver Lesiakowski</p>
      </div>
    </footer>

    <!-- ===================== PHOTO VIEWER ===================== -->
    <dialog class="lb" id="lb" aria-label="Photo viewer">
      <span class="lb-count mono" id="lbCount" aria-live="polite"></span>
      <figure class="lb-fig">
        <img class="lb-img" id="lbImg" alt="" />
        <figcaption class="lb-cap" id="lbCap"></figcaption>
      </figure>
      <button class="lb-btn lb-prev" id="lbPrev" type="button" aria-label="Previous photo">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg>
      </button>
      <button class="lb-btn lb-next" id="lbNext" type="button" aria-label="Next photo">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
      </button>
      <button class="lb-btn lb-close" id="lbClose" type="button" aria-label="Close photo viewer">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </dialog>

    <!-- deep links (#education etc.): show the right page before first paint -->
    <script is:inline>
      (function () {
        var v = (location.hash || '').slice(1).split('/')[0];
        if (v !== 'education' && v !== 'experience' && v !== 'projects') return;
        document.getElementById('home').classList.remove('active');
        document.getElementById(v).classList.add('active');
        document.getElementById('siteFooter').hidden = false;
        var tabs = document.querySelectorAll('.tab');
        for (var i = 0; i < tabs.length; i++) {
          if (tabs[i].getAttribute('data-nav') === v) tabs[i].setAttribute('aria-current', 'page');
          else tabs[i].removeAttribute('aria-current');
        }
      })();
    </script>

    <script>
      // @ts-nocheck
      const root = document.documentElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const VIEWS = ['home', 'education', 'experience', 'projects'];
      const $ = (s, el = document) => el.querySelector(s);
      const $$ = (s, el = document) => Array.from(el.querySelectorAll(s));

      /* restart an element's CSS entrance animations (display:none → shown restarts them) */
      function replay(el) {
        if (!el) return;
        const was = el.hidden;
        el.hidden = true;
        void el.offsetWidth;
        el.hidden = was;
      }
      /* lazy images inside hidden panels / carousels: load them once the panel is shown */
      function eager(el) {
        if (el) $$('img[loading="lazy"]', el).forEach((img) => { img.loading = 'eager'; });
      }

      /* ---------------- theme (light default, remembered) ---------------- */
      const themeBtn = $('#themeBtn');
      const metaTheme = $('meta[name="theme-color"]');
      function syncTheme() {
        const dark = root.dataset.olTheme === 'dark';
        const label = dark ? 'Switch to light mode' : 'Switch to dark mode';
        themeBtn.setAttribute('aria-label', label);
        themeBtn.title = label;
        if (metaTheme) metaTheme.setAttribute('content', dark ? '#0a0a0b' : '#f5f5f7');
      }
      function setTheme(t) {
        root.dataset.olTheme = t;
        try { sessionStorage.setItem('ol-theme', t); } catch (e) {}
        syncTheme();
      }
      syncTheme();
      themeBtn.addEventListener('click', () => {
        const next = root.dataset.olTheme === 'dark' ? 'light' : 'dark';
        const r = themeBtn.getBoundingClientRect();
        root.style.setProperty('--tx', r.left + r.width / 2 + 'px');
        root.style.setProperty('--ty', r.top + r.height / 2 + 'px');
        if (!document.startViewTransition || reduce.matches) { setTheme(next); return; }
        root.classList.add('theme-swap');
        const vt = document.startViewTransition(() => setTheme(next));
        vt.finished.finally(() => root.classList.remove('theme-swap'));
      });

      /* ---------------- nav pill ---------------- */
      const tabsEl = $('#navTabs');
      const tabs = $$('.tab', tabsEl);
      const ind = $('#navInd');
      function setTabs(name) {
        tabs.forEach((t) => {
          if (t.dataset.nav === name) t.setAttribute('aria-current', 'page');
          else t.removeAttribute('aria-current');
        });
      }
      function moveInd(snap) {
        const cur = tabs.find((t) => t.getAttribute('aria-current') === 'page');
        if (!cur) return;
        if (snap) ind.classList.add('snap');
        ind.style.left = cur.offsetLeft + 'px';
        ind.style.width = cur.offsetWidth + 'px';
        if (snap) { void ind.offsetWidth; ind.classList.remove('snap'); }
      }

      /* ---------------- page switching ---------------- */
      const footer = $('#siteFooter');
      let switching = false;
      function showView(name) {
        const next = document.getElementById(name);
        const cur = $('.screen.active');
        if (!next || !VIEWS.includes(name) || switching) return;
        if (cur === next) { if (name === 'projects') closeProject(); return; }
        setTabs(name);
        moveInd(false);
        history.replaceState(null, '', '#' + name);
        const activate = () => {
          if (cur) cur.classList.remove('active', 'exiting');
          footer.classList.remove('exiting');
          root.classList.remove('intro'); // Home gets the quick load-in from now on
          if (name === 'projects') resetProjects();
          next.classList.add('active');
          footer.hidden = true;
          void footer.offsetWidth;
          footer.hidden = false;
          window.scrollTo(0, 0);
          if (name === 'experience') updateFill();
          if (name === 'projects') kickTiles();
          switching = false;
        };
        if (!cur || reduce.matches) { activate(); return; }
        switching = true;
        cur.classList.add('exiting');
        if (!footer.hidden) footer.classList.add('exiting');
        setTimeout(activate, 240);
      }

      /* ---------------- home: scroll cue + About reveal ---------------- */
      const cue = $('#cue');
      const aboutEl = $('#about');
      if (cue && aboutEl) {
        cue.addEventListener('click', () => {
          const top = aboutEl.getBoundingClientRect().top + window.scrollY;
          window.scrollTo({ top, behavior: reduce.matches ? 'auto' : 'smooth' });
        });
        const syncCue = () => cue.classList.toggle('gone', window.scrollY > 60);
        window.addEventListener('scroll', syncCue, { passive: true });
        syncCue();
      }
      if ('IntersectionObserver' in window && !reduce.matches) {
        const io = new IntersectionObserver((ents) => {
          ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        $$('.rv').forEach((el) => io.observe(el));
        root.classList.add('rv-on');
      }

      /* ---------------- education: coursework filter ---------------- */
      const cwLegend = $('#cwLegend');
      const tgrid = $('#tgrid');
      if (cwLegend && tgrid) {
        cwLegend.addEventListener('click', (e) => {
          const b = e.target.closest('[data-grp]');
          if (!b) return;
          const g = tgrid.dataset.f === b.dataset.grp ? '' : b.dataset.grp;
          $$('[data-grp]', cwLegend).forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.grp === g)));
          $$('li[data-grp]', tgrid).forEach((li) => li.classList.toggle('on', li.dataset.grp === g));
          if (g) tgrid.dataset.f = g; else delete tgrid.dataset.f;
        });
      }

      /* ---------------- experience: timeline + photo carousels ---------------- */
      const xpBtns = $$('[data-exp]');
      const xpPanels = $$('[data-panel]');
      const tlFill = $('#tlFill');
      let xsel = 0;
      function updateFill() {
        const b = xpBtns[xsel];
        if (!b || !tlFill || !b.offsetParent || !tlFill.offsetParent) return;
        tlFill.style.height = Math.max(0, b.offsetTop + b.offsetHeight / 2 - tlFill.offsetTop) + 'px';
      }

      const carousels = new Map();
      let lastSwipe = 0;
      $$('[data-car]').forEach((el) => {
        const track = $('.car-track', el);
        const slides = Array.from(track.children);
        const dots = $$('.car-dot', el);
        const count = $('.car-count', el);
        const n = slides.length;
        let k = 0;
        if (n < 2) el.classList.add('single');
        const go = (to, instant) => {
          k = ((to % n) + n) % n;
          if (instant) track.style.transition = 'none';
          track.style.transform = 'translateX(' + -k * 100 + '%)';
          if (instant) { void track.offsetWidth; track.style.transition = ''; }
          dots.forEach((d, j) => d.setAttribute('aria-current', String(j === k)));
          slides.forEach((s, j) => s.setAttribute('aria-hidden', String(j !== k)));
          if (count) count.textContent = k + 1 + ' / ' + n;
        };
        $('.car-prev', el).addEventListener('click', () => go(k - 1));
        $('.car-next', el).addEventListener('click', () => go(k + 1));
        dots.forEach((d, j) => d.addEventListener('click', () => go(j)));
        el.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') { go(k - 1); e.preventDefault(); }
          else if (e.key === 'ArrowRight') { go(k + 1); e.preventDefault(); }
        });
        let x0 = null; // touch swipe
        el.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse' && !e.target.closest('button')) x0 = e.clientX; });
        el.addEventListener('pointerup', (e) => {
          if (x0 === null) return;
          const dx = e.clientX - x0;
          x0 = null;
          if (Math.abs(dx) > 40) { lastSwipe = performance.now(); go(dx < 0 ? k + 1 : k - 1); }
        });
        el.addEventListener('pointercancel', () => { x0 = null; });
        go(0, true);
        carousels.set(el, { go });
      });

      function selectExp(i) {
        if (i === xsel || !xpPanels[i]) return;
        xsel = i;
        xpBtns.forEach((b, k) => {
          b.setAttribute('aria-pressed', String(k === i));
          b.classList.toggle('reached', k <= i);
        });
        xpPanels.forEach((p, k) => { p.hidden = k !== i; }); // re-showing a panel replays its entrance
        eager(xpPanels[i]);
        const car = carousels.get($('[data-car]', xpPanels[i]));
        if (car) car.go(0, true);
        updateFill();
      }

      /* ---------------- projects: filters, featured, project pages ---------------- */
      const projSec = $('#projects');
      const ov = $('#projMain');
      const FEAT_ALL = projSec.dataset.featAll || 'done';
      const tileBtns = $$('[data-filter]');
      const feats = $$('[data-feat]');
      const shelves = $('#shelves');
      const grids = $$('[data-grid]');
      const details = new Map($$('[data-pd]').map((el) => [el.dataset.pd, el]));
      let filter = 'all';
      let openKey = null;
      let opener = null;
      let savedY = 0;
      let calmAt = 0;

      function setFilter(f) {
        if (f === filter || (f !== 'all' && !grids.some((g) => g.dataset.grid === f))) return;
        if (ov.classList.contains('calm') && performance.now() - calmAt > 2000) ov.classList.remove('calm');
        filter = f;
        tileBtns.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.filter === f)));
        const fk = f === 'all' ? FEAT_ALL : f;
        feats.forEach((el) => {
          const on = el.dataset.feat === fk;
          if (on && !el.hidden) replay(el);
          el.hidden = !on;
        });
        shelves.hidden = f !== 'all';
        grids.forEach((g) => { g.hidden = g.dataset.grid !== f; });
        kickTiles();
      }

      function openProject(key) {
        const pd = details.get(key);
        if (!pd) return;
        if (!openKey) savedY = window.scrollY;
        details.forEach((el) => { el.hidden = el !== pd; });
        if (openKey === key) replay(pd);
        ov.hidden = true;
        openKey = key;
        window.scrollTo(0, 0);
        history.replaceState(null, '', '#projects/' + key);
        const h = $('.pd-title', pd);
        if (h) h.focus({ preventScroll: true });
      }
      function closeProject() {
        if (!openKey) return;
        details.get(openKey).hidden = true;
        openKey = null;
        ov.classList.add('calm');
        calmAt = performance.now();
        ov.hidden = false;
        kickTiles();
        history.replaceState(null, '', '#projects');
        window.scrollTo(0, savedY);
        if (opener && document.contains(opener) && opener.offsetParent) opener.focus({ preventScroll: true });
      }
      function resetProjects() {
        if (openKey) {
          details.get(openKey).hidden = true;
          openKey = null;
          ov.hidden = false;
        }
        ov.classList.remove('calm');
      }

      /* ---------------- filter-tile icons: smooth speed-up ----------------
         The icons are plain CSS animations. Hover / pick used to swap animation-duration,
         which makes the browser recompute progress and jump. Instead we ease each running
         animation's playbackRate toward a target, so it keeps its current position. */
      const FAST = 3.4;
      const tileSt = new Map(tileBtns.map((t) => [t, { rate: 1, hover: false, rig: null }]));
      let tileRaf = 0;
      const iconAnims = (t) => {
        const ic = $('.tile-icon', t);
        return ic && ic.getAnimations ? ic.getAnimations({ subtree: true }).filter((a) => !(tileSt.get(t).rig === a)) : [];
      };
      function rollRig(t, s, on) {
        const el = $('.ic-rig', t);
        if (!el || !el.animate) return;
        const a = s.rig;
        const looping = a && a.playState !== 'finished' && a.effect.getTiming().iterations === Infinity;
        if (on && !looping) {
          if (a && a.playState === 'running') { a.effect.updateTiming({ iterations: Infinity }); return; }
          s.rig = el.animate(
            [{ transform: 'translateX(0)', easing: 'ease-in-out' }, { transform: 'translateX(-10px)', easing: 'ease-in-out' }, { transform: 'translateX(0)' }],
            { duration: 2200, iterations: Infinity }
          );
        } else if (!on && looping) {
          // finish the current roll and come to rest at 0 instead of snapping
          a.effect.updateTiming({ iterations: Math.floor((a.currentTime || 0) / 2200) + 1 });
        }
      }
      function stepTiles() {
        tileRaf = 0;
        let busy = false;
        tileSt.forEach((s, t) => {
          const on = s.hover || t.getAttribute('aria-pressed') === 'true';
          const target = on ? (t.dataset.filter === 'all' ? 1.8 : FAST) : 1;
          const d = target - s.rate;
          s.rate = Math.abs(d) < 0.02 ? target : s.rate + d * 0.1;
          if (s.rate !== target) busy = true;
          iconAnims(t).forEach((a) => { if (a.playbackRate !== s.rate) a.playbackRate = s.rate; });
          rollRig(t, s, on);
        });
        if (busy) tileRaf = requestAnimationFrame(stepTiles);
      }
      function kickTiles() {
        if (reduce.matches || tileRaf) return;
        tileRaf = requestAnimationFrame(stepTiles);
      }
      tileBtns.forEach((t) => {
        t.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { tileSt.get(t).hover = true; kickTiles(); } });
        t.addEventListener('pointerleave', () => { tileSt.get(t).hover = false; kickTiles(); });
        t.addEventListener('focus', () => { if (t.matches(':focus-visible')) { tileSt.get(t).hover = true; kickTiles(); } });
        t.addEventListener('blur', () => { tileSt.get(t).hover = false; kickTiles(); });
      });

      /* ---------------- photo viewer ---------------- */
      const lb = $('#lb');
      const lbImg = $('#lbImg');
      const lbCap = $('#lbCap');
      const lbCount = $('#lbCount');
      let lbList = [];
      let lbAt = 0;
      let lbFrom = null;
      const zoomable = (el) => el.hasAttribute('data-zoom-ready') || !!$('img', el);
      function zoomItem(el) {
        return { src: el.dataset.zoom, cap: el.dataset.cap || '', cad: el.classList.contains('cad') };
      }
      function lbShow(i) {
        const n = lbList.length;
        lbAt = ((i % n) + n) % n;
        const it = lbList[lbAt];
        lbImg.classList.toggle('cad', it.cad);
        lbImg.style.animation = 'none';
        void lbImg.offsetWidth;
        lbImg.style.animation = '';
        lbImg.src = it.src;
        lbImg.alt = it.cap;
        lbCap.textContent = it.cap;
        lbCount.textContent = lbAt + 1 + ' / ' + n;
        [lbAt + 1, lbAt - 1].forEach((j) => { const nx = lbList[((j % n) + n) % n]; if (nx) new Image().src = nx.src; });
      }
      function openZoom(el) {
        if (!zoomable(el) || !lb.showModal) return;
        const group = el.closest('[data-zoom-group]');
        const els = group ? $$('[data-zoom]', group).filter(zoomable) : [el];
        const seen = new Set();
        lbList = [];
        let at = 0;
        els.forEach((z) => {
          const it = zoomItem(z);
          if (!it.src || seen.has(it.src)) { if (z === el) at = lbList.findIndex((x) => x.src === it.src); return; }
          seen.add(it.src);
          if (z === el) at = lbList.length;
          lbList.push(it);
        });
        if (!lbList.length) return;
        lbFrom = el;
        lb.classList.toggle('solo', lbList.length < 2);
        lbShow(Math.max(0, at));
        lb.classList.remove('closing');
        root.classList.add('lb-open');
        lb.showModal();
        $('#lbClose').focus({ preventScroll: true });
      }
      function closeZoom() {
        if (!lb.open || lb.classList.contains('closing')) return;
        const done = () => {
          lb.classList.remove('closing');
          lb.close();
          root.classList.remove('lb-open');
          if (lbFrom && document.contains(lbFrom)) lbFrom.focus({ preventScroll: true });
        };
        if (reduce.matches) { done(); return; }
        lb.classList.add('closing');
        setTimeout(done, 190);
      }
      $('#lbPrev').addEventListener('click', () => lbShow(lbAt - 1));
      $('#lbNext').addEventListener('click', () => lbShow(lbAt + 1));
      $('#lbClose').addEventListener('click', closeZoom);
      lb.addEventListener('cancel', (e) => { e.preventDefault(); closeZoom(); });
      lb.addEventListener('click', (e) => { if (e.target === lb || e.target.classList.contains('lb-fig')) closeZoom(); });
      lb.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { lbShow(lbAt - 1); e.preventDefault(); }
        else if (e.key === 'ArrowRight') { lbShow(lbAt + 1); e.preventDefault(); }
      });
      let lbX = null;
      lbImg.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') lbX = e.clientX; });
      lbImg.addEventListener('pointerup', (e) => {
        if (lbX === null) return;
        const dx = e.clientX - lbX;
        lbX = null;
        if (Math.abs(dx) > 40 && lbList.length > 1) lbShow(dx < 0 ? lbAt + 1 : lbAt - 1);
      });

      /* ---------------- clicks & keys ---------------- */
      document.addEventListener('click', (e) => {
        const z = e.target.closest('[data-zoom]');
        if (z && !lb.contains(z)) {
          if (performance.now() - lastSwipe > 350) openZoom(z);
          return;
        }
        const t = e.target.closest('[data-nav],[data-exp],[data-filter],[data-see],[data-open],[data-back]');
        if (!t) return;
        const d = t.dataset;
        if (d.nav) showView(d.nav);
        else if (d.exp) selectExp(Number(d.exp));
        else if (d.filter) setFilter(d.filter);
        else if (d.see) {
          setFilter(d.see);
          const top = $('#tiles').getBoundingClientRect().top + window.scrollY - 100;
          window.scrollTo({ top: Math.max(0, top), behavior: reduce.matches ? 'auto' : 'smooth' });
        } else if (d.open) {
          if (!t.closest('.pd')) opener = t;
          openProject(d.open);
        } else if ('back' in d) closeProject();
      });
      document.addEventListener('keydown', (e) => {
        if (lb.open) return;
        const z = e.target.closest && e.target.closest('[data-zoom]');
        if (z && z.tagName !== 'BUTTON' && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openZoom(z); return; }
        if (e.key === 'Escape' && openKey) closeProject();
      });

      /* ---------------- boot ---------------- */
      function parseHash() {
        const [v, sub] = decodeURIComponent(location.hash.slice(1)).split('/');
        return { view: VIEWS.includes(v) ? v : 'home', sub };
      }
      const start = parseHash();
      $$('.screen').forEach((s) => s.classList.toggle('active', s.id === start.view));
      setTabs(start.view);
      footer.hidden = false;
      if (start.view !== 'home') root.classList.remove('intro');
      if (start.view === 'projects' && details.has(start.sub)) openProject(start.sub);
      eager(xpPanels[0]);
      moveInd(true);
      updateFill();
      kickTiles();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { moveInd(true); updateFill(); });
      if ('ResizeObserver' in window) new ResizeObserver(() => moveInd(true)).observe(tabsEl);
      window.addEventListener('resize', updateFill);
      window.addEventListener('hashchange', () => {
        const h = parseHash();
        const onIt = $('.screen.active') === document.getElementById(h.view);
        if (!onIt) showView(h.view);
        if (h.view === 'projects' && details.has(h.sub)) setTimeout(() => openProject(h.sub), onIt || reduce.matches ? 0 : 260);
      });
    </script>
  </body>
</html>