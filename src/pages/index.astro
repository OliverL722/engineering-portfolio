              <header class="fx-rise">
                <p class="pd-kick mono"><span class="tag">{p.cat.kicker}</span>{p.time.toUpperCase() !== p.cat.kicker && <span>{p.time.toUpperCase()}</span>}</p>
                <h2 class="pd-title" id={`pd-${p.key}`} tabindex="-1">{p.title}</h2>
                <p class="pd-desc">{p.description}</p>
